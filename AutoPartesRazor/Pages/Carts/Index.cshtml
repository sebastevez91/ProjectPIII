@page
@model AutoPartesRazor.Pages.Carts.IndexModel

@{
    ViewData["Title"] = "Carrito de compras";
    ViewData["CartCount"] = Model.CartCount;
}

@if (TempData["SuccessMessage"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            Swal.fire({
                title: '¡Éxito!',
                text: '@TempData["SuccessMessage"]',
                icon: 'success',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true
            });
        });
    </script>
}

@if (TempData["ErrorMessage"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            Swal.fire({
                title: 'Error',
                text: '@TempData["ErrorMessage"]',
                icon: 'error',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 4000,
                timerProgressBar: true
            });
        });
    </script>
}

<div class="container py-4">
    <div class="hero-section bg-primary bg-gradient text-white py-2 text-center m-2">
        <div class="container py-4">
            <h1 class="mb-4"><i class="fa-solid fa-car-battery me-2"></i>Tu carrito de repuestos</h1>
        </div>
    </div>

    @if (Model.Cart.Any())
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="list-group">
                    @foreach (var item in Model.Cart)
                    {
                        var lineTotal = item.Quantity * item.Product.Price;
                        <div class="list-group-item mb-3 shadow-sm rounded">
                            <div class="row g-3 align-items-center">
                                <div class="col-3 col-md-2">
                                    <img src="@(string.IsNullOrEmpty(@item.Product.ImagePath) ? "/img/logoAzul.jpg" : item.Product.ImagePath)"
                                         class="img-fluid product-thumb rounded"
                                         onerror="this.src='/img/logoAzul.jpg'">
                                </div>
                                <div class="col-6 col-md-7">
                                    <h5 class="mb-1">@item.Product.Name</h5>
                                    <small class="text-muted">Código: @item.ProductId</small>
                                    <div class="mt-2">
                                        <span class="badge bg-primary">
                                            <i class="fa-solid fa-industry me-1"></i> Repuestos
                                        </span>
                                    </div>
                                </div>
                                <div class="col-3 col-md-3 text-end">
                                    <div class="mb-2 fw-bold">@item.Product.Price.ToString("C")</div>

                                    <div class="input-group input-group-sm justify-content-end mb-2" style="width:160px;margin-left:auto;">
                                        <input type="text" readonly class="form-control text-center qty-input"
                                               id="qty_@item.Id" value="@item.Quantity un."
                                               style="max-width:60px;" data-price="@item.Product.Price" />
                                    </div>

                                    <div class="small text-muted">Total: <span id="lineTotal_@item.Id">@lineTotal.ToString("C")</span></div>

                                    <div class="mt-2">
                                        <a asp-page="/Products/Details" asp-route-id="@item.ProductId"
                                           class="btn btn-sm btn-outline-secondary me-1">
                                            <i class="fa-solid fa-eye"></i> Ver
                                        </a>
                                        <button type="button" class="btn btn-sm btn-danger"
                                                data-bs-toggle="modal" data-bs-target="#deleteModal_@item.Id">
                                            <i class="fa-solid fa-trash"></i> Eliminar
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Modal de confirmación -->
                            <div class="modal fade" id="deleteModal_@item.Id" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title">Confirmar eliminación</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">
                                            ¿Está seguro que desea eliminar el producto <strong>@item.Product.Name</strong> del carrito?
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary m-2" data-bs-dismiss="modal">Cancelar</button>
                                            <form method="post" asp-page="./Delete" asp-route-id="@item.Id" style="display:inline;">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-danger">Eliminar</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card summary-card sticky-top p-3">
                    <h5 class="card-title mb-3">
                        <i class="fa-solid fa-list-check me-2"></i>Resumen del pedido
                    </h5>

                    <!-- SECCIÓN DE CUPÓN -->
                    <div class="mb-3 p-3 bg-light rounded">
                        <h6 class="mb-2">
                            <i class="fa-solid fa-ticket me-2 text-warning"></i>¿Tienes un cupón?
                        </h6>

                        @if (Model.AppliedCoupon == null)
                        {
                            <form method="post" asp-page-handler="ApplyCoupon">
                                <div class="input-group input-group-sm">
                                    <input type="text" asp-for="CouponCode" class="form-control"
                                           placeholder="Código de cupón" />
                                    <button type="submit" class="btn btn-warning">
                                        <i class="fa-solid fa-check"></i> Aplicar
                                    </button>
                                </div>
                            </form>
                        }
                        else
                        {
                            <div class="alert alert-success mb-2 p-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@Model.AppliedCoupon.Code</strong>
                                        <br />
                                        <small>-@Model.AppliedCoupon.DiscountPercentage% de descuento</small>
                                    </div>
                                    <form method="post" asp-page-handler="RemoveCoupon">
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="fa-solid fa-times"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>

                            @if (Model.AppliedCoupon.ProductId.HasValue)
                            {
                                <small class="text-muted">
                                    <i class="fa-solid fa-info-circle me-1"></i>
                                    Aplica solo a: <strong>@Model.AppliedCoupon.Product?.Name</strong>
                                </small>
                            }
                            else
                            {
                                <small class="text-success">
                                    <i class="fa-solid fa-check-circle me-1"></i>
                                    Aplica a toda la compra
                                </small>
                            }
                        }
                    </div>

                    <!-- RESUMEN DE PRECIOS -->
                    <div class="mb-2 d-flex justify-content-between">
                        <div>Subtotal (@Model.Cart.Sum(i => i.Quantity) items)</div>
                        <div>@Model.Subtotal.ToString("C")</div>
                    </div>

                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="mb-2 d-flex justify-content-between text-success">
                            <div>
                                <i class="fa-solid fa-tag me-1"></i>Descuento (@Model.AppliedCoupon!.DiscountPercentage%)
                            </div>
                            <div><strong>-@Model.DiscountAmount.ToString("C")</strong></div>
                        </div>
                    }

                    <div class="mb-2 d-flex justify-content-between">
                        <div>Envío</div>
                        <div>Gratis</div>
                    </div>

                    <hr />

                    <div class="mb-3 d-flex justify-content-between fs-5 fw-bold">
                        <div>Total</div>
                        <div class="@(Model.DiscountAmount > 0 ? "text-success" : "")">
                            @Model.Total.ToString("C")
                        </div>
                    </div>

                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="alert alert-success p-2 mb-3">
                            <small>
                                <i class="fa-solid fa-check-circle me-1"></i>
                                ¡Ahorras @Model.DiscountAmount.ToString("C")!
                            </small>
                        </div>
                    }

                    <a asp-page="/Products/Index" class="btn btn-outline-primary w-100 mb-2">
                        <i class="fa-solid fa-arrow-left me-2"></i> Seguir comprando
                    </a>

                    @* ✅ CAMBIO AQUÍ: Pasar el cupón al crear la orden *@
                    @if (Model.AppliedCoupon != null)
                    {
                        <a asp-page="/Orders/Create"
                           asp-route-appliedCouponCode="@Model.AppliedCoupon.Code"
                           class="btn btn-success w-100">
                            <i class="fa-solid fa-credit-card me-2"></i> Proceder al pago
                        </a>
                    }
                    else
                    {
                        <a asp-page="/Orders/Create" class="btn btn-success w-100">
                            <i class="fa-solid fa-credit-card me-2"></i> Proceder al pago
                        </a>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No hay productos en el carrito.
        </div>
        <a asp-page="/Products/Index" class="btn btn-primary">Ir al Catálogo</a>
    }
</div>