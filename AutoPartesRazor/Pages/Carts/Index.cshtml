@section Scripts {
    <script>
        function formatCurrency(value) {
            return new Intl.NumberFormat('@System.Globalization.CultureInfo.CurrentCulture.Name', { style: 'currency', currency: '@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.CurrencySymbol' }).format(value);
        }

        // Funcion para cambiar la cantidad
        function changeQty(itemId, delta) {
            const qtyInput = document.getElementById('qty_' + itemId);
            if (!qtyInput) return;
            let qty = parseInt(qtyInput.value, 10) || 0;
            qty = Math.max(1, qty + delta);
            qtyInput.value = qty;

            const price = parseFloat(qtyInput.dataset.price);
            const lineTotal = qty * price;
            document.getElementById('lineTotal_' + itemId).innerText = lineTotal.toLocaleString(undefined, { style: 'currency', currency: '@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.CurrencySymbol' });

            // Recalcular subtotal y total (cliente)
            let subtotal = 0;
            document.querySelectorAll('.qty-input').forEach(function (el) {
                const q = parseInt(el.value, 10) || 0;
                const p = parseFloat(el.dataset.price) || 0;
                subtotal += q * p;
            });
            document.getElementById('subtotal').innerText = subtotal.toLocaleString(undefined, { style: 'currency', currency: '@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.CurrencySymbol' });
            document.getElementById('grandTotal').innerText = document.getElementById('subtotal').innerText;
        }
    </script>
}

