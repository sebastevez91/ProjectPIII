@page
@model AutoPartesRazor.Pages.Products.EditModel

@{
    ViewData["Title"] = "Editar";
}

<h1>Editar producto</h1>

<h4>Producto</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post" enctype="multipart/form-data">
            <div class="form-group">
                <img src="@(string.IsNullOrEmpty(Model.Product.ImagePath) ? "/img/logoAzul.jpg" : Model.Product.ImagePath)" class="img-fluid rounded mb-3" alt="Imagen del producto" oonerror="this.src='/img/logoAzul.jpg'">
            </div>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Product.Id" />
            <input type="hidden" asp-for="Product.ImagePath" />
            <input type="hidden" asp-for="Product.Stock" />
            <div class="form-group">
                <label asp-for="Product.Name" class="control-label"></label>
                <input asp-for="Product.Name" class="form-control" />
                <span asp-validation-for="Product.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Product.Description" class="control-label"></label>
                <input asp-for="Product.Description" class="form-control" />
                <span asp-validation-for="Product.Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Product.Price" class="control-label"></label>
                <input asp-for="@Model.PriceInteger" class="form-control" />
                <span asp-validation-for="Product.Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Product.Category.Name" class="control-label text-white"></label>
                <select asp-for="Product.CategoryId" class="form-select"
                        asp-items="Model.Categories">
                    <option value="">-- Seleccione una categoría --</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="Product.Brand.Name" class="control-label text-white"></label>
                <select asp-for="Product.BrandId" class="form-select"
                        asp-items="Model.Brands">
                    <option value="">-- Seleccione una marca --</option>
                </select>
            </div>
            <div class="form-group">
                <label class="control-label text-white">Imagen del producto</label>
                <input type="file" asp-for="ImageFile" class="form-control" />
            </div>
            <div class="form-group  text-center m-4">
                <button type="submit" class="btn btn-primary btn-lg">Guardar</button>
                <a asp-page="/Administration/AdminDashboard" class="btn btn-primary btn-lg">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
