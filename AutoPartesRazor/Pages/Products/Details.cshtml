@page
@model AutoPartesRazor.Pages.Products.DetailsModel
@{
    ViewData["Title"] = "Detalles";
    ViewData["CartCount"] = Model.CartCount;
}

<div class="container py-4">
    <h1>Detalles del producto</h1>

    <div class="row">
        <!-- Columna de la imagen -->
        <div class="col-md-5">
            <img src="@(string.IsNullOrEmpty(Model.Product.ImagePath) ? "/img/logoAzul.jpg" : Model.Product.ImagePath)" 
                 class="img-fluid rounded shadow" 
                 alt="@Model.Product.name" 
                 onerror="this.src='/img/logoAzul.jpg'" />
        </div>

        <!-- Columna de detalles -->
        <div class="col-md-7">
            <hr />
            <dl class="row">
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Product.name)
                </dt>
                <dd class="col-sm-8">
                    <strong>@Html.DisplayFor(model => model.Product.name)</strong>
                </dd>

                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Product.description)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Product.description)
                </dd>

                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Product.stock)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Product.stock)
                </dd>

                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Product.price)
                </dt>
                <dd class="col-sm-8">
                    <strong class="text-success">$ @Html.DisplayFor(model => model.Product.price)</strong>
                </dd>

                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Product.Category.name)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Product.Category.name)
                </dd>

                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Product.Brand.name)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Product.Brand.name)
                </dd>
            </dl>

            <div class="mt-3">
                <a asp-page="./Index" class="btn btn-primary">
                    <i class="fa-solid fa-arrow-left me-1"></i>
                    Ir al catálogo
                </a>
            </div>
        </div>
    </div>

    <!-- ============================================ -->
    <!-- ⬇️⬇️⬇️ NUEVA SECCIÓN DE RESEÑAS ⬇️⬇️⬇️ -->
    <!-- ============================================ -->
    
    <div class="mt-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4>
                <i class="fa-solid fa-star text-warning me-2"></i>
                Opiniones de clientes
            </h4>
            <a asp-page="/Products/Reviews" 
               asp-route-productId="@Model.Product.id" 
               class="btn btn-outline-primary btn-sm">
                Ver todas (@Model.Product.TotalReviews)
            </a>
        </div>

        @if (Model.Product.TotalReviews > 0)
        {
            <!-- Card con resumen de calificaciones -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="row align-items-center">
                        <!-- Columna izquierda: Promedio -->
                        <div class="col-md-4 text-center border-end">
                            <h2 class="display-4 mb-0 fw-bold">@Model.Product.AverageRating.ToString("0.0")</h2>
                            <div class="text-warning fs-4 mb-2">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Model.Product.AverageRating)
                                    {
                                        <i class="fa-solid fa-star"></i>
                                    }
                                    else if (i - 0.5 <= Model.Product.AverageRating)
                                    {
                                        <i class="fa-solid fa-star-half-stroke"></i>
                                    }
                                    else
                                    {
                                        <i class="fa-regular fa-star"></i>
                                    }
                                }
                            </div>
                            <p class="text-muted mb-0">
                                @Model.Product.TotalReviews reseña@(Model.Product.TotalReviews != 1 ? "s" : "")
                            </p>
                            <p class="text-success small mb-0">
                                <i class="fa-solid fa-thumbs-up me-1"></i>
                                @Model.Product.PositiveReviewsPercentage% satisfecho
                            </p>
                        </div>

                        <!-- Columna derecha: Botón de reseña -->
                        <div class="col-md-8 ps-4">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                @if (Model.UserHasReviewed)
                                {
                                    <div class="alert alert-success mb-0">
                                        <i class="fa-solid fa-check-circle me-2"></i>
                                        <strong>Ya has reseñado este producto</strong>
                                        <p class="mb-0 mt-2">
                                            <a asp-page="/Products/Reviews" 
                                               asp-route-productId="@Model.Product.id" 
                                               class="alert-link">
                                                Ver tu reseña →
                                            </a>
                                        </p>
                                    </div>
                                }
                                else
                                {
                                    <h6 class="mb-3">¿Ya compraste este producto?</h6>
                                    <a asp-page="/Products/CreateReview" 
                                       asp-route-productId="@Model.Product.id" 
                                       class="btn btn-warning btn-lg">
                                        <i class="fa-solid fa-star me-2"></i>
                                        Escribir reseña
                                    </a>
                                    <p class="text-muted small mt-2 mb-0">
                                        Comparte tu experiencia con otros clientes
                                    </p>
                                }
                            }
                            else
                            {
                                <h6 class="mb-3">¿Ya compraste este producto?</h6>
                                <a asp-page="/Account/Login" 
                                   asp-route-returnUrl="@($"/Products/Details?id={Model.Product.id}")"
                                   class="btn btn-outline-primary">
                                    <i class="fa-solid fa-right-to-bracket me-2"></i>
                                    Inicia sesión para reseñar
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mostrar últimas 3 reseñas -->
            @if (Model.Product.Reviews != null && Model.Product.Reviews.Any())
            {
                <h5 class="mb-3">Reseñas recientes</h5>
                @foreach (var review in Model.Product.Reviews.OrderByDescending(r => r.CreatedAt).Take(3))
                {
                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <div class="text-warning mb-1">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <i class="fa-solid fa-star@(i <= review.Rating ? "" : " text-muted")"></i>
                                        }
                                    </div>
                                    <h6 class="mb-0">
                                        @review.User?.UserName
                                        <span class="badge bg-primary ms-2">Compra Verificada</span>
                                    </h6>
                                    <small class="text-muted">@review.CreatedAt.ToString("dd/MM/yyyy")</small>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(review.Comment))
                            {
                                <p class="mb-2">@review.Comment</p>
                            }

                            <div class="d-flex align-items-center gap-2 text-muted small">
                                <i class="fa-solid fa-thumbs-up"></i>
                                <span>@review.HelpfulCount personas encontraron esto útil</span>
                            </div>
                        </div>
                    </div>
                }

                @if (Model.Product.TotalReviews > 3)
                {
                    <div class="text-center mt-3">
                        <a asp-page="/Products/Reviews" 
                           asp-route-productId="@Model.Product.id" 
                           class="btn btn-outline-secondary">
                            Ver todas las reseñas (@Model.Product.TotalReviews) →
                        </a>
                    </div>
                }
            }
        }
        else
        {
            <!-- Si no hay reseñas -->
            <div class="card shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="fa-regular fa-star fs-1 text-muted mb-3"></i>
                    <h5>Este producto aún no tiene reseñas</h5>
                    
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <p class="text-muted mb-3">¡Sé el primero en compartir tu opinión!</p>
                        <a asp-page="/Products/CreateReview" 
                           asp-route-productId="@Model.Product.id" 
                           class="btn btn-warning">
                            <i class="fa-solid fa-star me-2"></i>
                            Escribir la primera reseña
                        </a>
                    }
                    else
                    {
                        <p class="text-muted mb-3">Inicia sesión para ser el primero en reseñar este producto</p>
                        <a asp-page="/Account/Login" 
                           asp-route-returnUrl="@($"/Products/Details?id={Model.Product.id}")"
                           class="btn btn-outline-primary">
                            <i class="fa-solid fa-right-to-bracket me-2"></i>
                            Iniciar sesión
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .product-img {
            max-height: 400px;
            object-fit: cover;
            width: 100%;
        }

        .fa-star {
            transition: color 0.2s;
        }

        .card {
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
    </style>
}