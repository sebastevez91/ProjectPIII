@page
@model AutoPartesRazor.Pages.Products.IndexModel

@{
    ViewData["Title"] = "Productos";
    ViewData["CartCount"] = Model.CartCount;
}

<div class="container py-4">
    <div class="hero-section bg-primary bg-gradient text-white py-2 text-center m-2">
        <div class="container py-4">
            <h1 class="display-4 fw-bold mb-1">Nuestro catalogo</h1> 
            <p class="lead">Repuestos y Accesorios</p>
        </div>
    </div>

    <!--Filtros de búsqueda-->
    <div class="row mb-3 g-2 align-items-center">
        <form method="get" class="row g-2 align-items-center" id="filterForm">
            <div class="col-md-4">
                <input asp-for="SearchQuery" class="form-control" placeholder="Buscar por nombre, descripción o marca..." value="@Model.SearchQuery" />
            </div>
            <div class="col-md-3">
                <select asp-for="CategoryFilter" asp-items="Model.Categories" class="form-select">
                    <option value="">Todas las categorías</option>
                </select>
            </div>
            <div class="col-md-3">
                <select asp-for="SortBy" class="form-select">
                    <option value="">Ordenar por...</option>
                    <option value="price_asc">Precio: Menor a Mayor</option>
                    <option value="price_desc">Precio: Mayor a Menor</option>
                    <option value="name_asc">Nombre: A-Z</option>
                    <option value="name_desc">Nombre: Z-A</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fa-solid fa-search me-1"></i>Buscar
                </button>
            </div>
        </form>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SearchQuery) || Model.CategoryFilter.HasValue || !string.IsNullOrWhiteSpace(Model.SortBy))
    {
        <div class="row mb-3">
            <div class="col-12">
                <div class="alert alert-light d-flex justify-content-between align-items-center">
                    <div>
                        <i class="fa-solid fa-filter me-2"></i>
                        <strong>Filtros activos:</strong>
                        @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                        {
                            <span class="badge bg-primary ms-2">Búsqueda: @Model.SearchQuery</span>
                        }
                        @if (Model.CategoryFilter.HasValue)
                        {
                            var categoryName = Model.Categories.FirstOrDefault(c => c.Value == Model.CategoryFilter.ToString())?.Text;
                            <span class="badge bg-info ms-2">Categoría: @categoryName</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.SortBy))
                        {
                            <span class="badge bg-secondary ms-2">Ordenado</span>
                        }
                    </div>
                    <a asp-page="/Products/Index" class="btn btn-sm btn-outline-secondary">
                        <i class="fa-solid fa-times me-1"></i>Limpiar filtros
                    </a>
                </div>
            </div>
        </div>
    }

    @if (!Model.Products.Any())
    {
        <div class="alert alert-info text-center py-5">
            <i class="fa-solid fa-search fa-3x mb-3 d-block text-muted"></i>
            <h5>No se encontraron productos</h5>
            <p class="mb-0">
                @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                {
                    <span>No hay productos que coincidan con "<strong>@Model.SearchQuery</strong>"</span>
                }
                else
                {
                    <span>Intenta ajustar tus filtros de búsqueda</span>
                }
            </p>
        </div>
    }
    else
    {
        <div class="row g-3 mb-3">
            <div class="col-12">
                <small class="text-muted">
                    <i class="fa-solid fa-box me-1"></i>
                    Mostrando <strong>@Model.Products.Count</strong> producto(s)
                    @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                    {
                        <span> para "<strong>@Model.SearchQuery</strong>"</span>
                    }
                </small>
            </div>
        </div>
    }

    <div id="productsGrid" class="row g-3">
        @if (User.IsInRole("Admin"))
        {
            <div class="container">
                <table class="table table-hover table-striped shadow-lg rounded">
                    <thead class="table-dark">
                        <tr class="animate__animated animate__fadeInDown">
                            <th>Código</th>
                            <th>Producto</th>
                            <th>Estado</th>
                            <th>Fecha</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var item in Model.Products)
                        {
                        <tr class="align-middle animate__animated animate__fadeInUp">
                                <td class="fw-bold">OV-#@item.Id</td>
                                <td>@item.Name</td>
                                <td>@item.IsDeleted</td>

                        </tr>                            
                        }

                    </tbody>
                </table>
            </div>
        }
        @foreach (var p in Model.Products)
        {
            <div class="col-12 col-sm-6 col-md-4">
                <div class="card h-100 shadow-sm">
                    <img src="@(string.IsNullOrEmpty(p.ImagePath) ? "/img/logoAzul.jpg" : p.ImagePath)" class="card-img-top product-img" alt="@p.Name" onerror="this.src='/img/logoAzul.jpg'">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@p.Name</h5>
                        <p class="card-text text-muted small">@p.Brand?.Name</p>
                        <p class="card-text mb-2">@p.Description</p>
                        <div class="mt-auto">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="fw-bold">@p.Price.ToString("C")</div>
                                <div class="text-muted small">Stock: @p.Stock</div>
                            </div>

                            <div class="d-flex gap-2 align-items-center mb-2">
                                <div class="input-group input-group-sm" style="width:120px;">
                                    <button class="btn btn-outline-secondary btn-sm" type="button" onclick="changeQty(@p.Id, -1)">
                                        <i class="fa-solid fa-minus"></i>
                                    </button>
                                    <input type="text" readonly class="form-control text-center qty-input" id="qty_@p.Id" value="1" data-product="@p.Id" data-price="@p.Price" />
                                    <button class="btn btn-outline-secondary btn-sm" type="button" onclick="changeQty(@p.Id, 1)">
                                        <i class="fa-solid fa-plus"></i>
                                    </button>
                                </div>
                                <button class="btn btn-success btn-sm ms-auto" onclick="addToCart(@p.Id)">
                                    <i class="fa-solid fa-cart-plus me-1"></i> Añadir
                                </button>
                            </div>

                            <div class="d-flex justify-content-between">
                                <a asp-page="./Details" asp-route-id="@p.Id" class="btn btn-link btn-sm p-0">Ver detalles</a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-page="./Edit" asp-route-id="@p.Id" class="btn btn-link btn-sm p-0">Editar</a>
                                }
                                <small class="text-muted">Código: @p.Id</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@* Anti-forgery token para AJAX *@
<form id="antiForgeryForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        // Helpers
        function changeQty(productId, delta) {
            const input = document.getElementById('qty_' + productId);
            if (!input) return;
            let v = parseInt(input.value, 10) || 1;
            v = Math.max(1, v + delta);
            input.value = v;
        }

        function getRequestVerificationToken() {
            const tokenInput = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]');
            return tokenInput ? tokenInput.value : '';
        }

        // Función global para actualizar el contador del carrito
        function updateCartCount(count) {
            const navCartCount = document.getElementById('navCartCount');
            if (navCartCount) {
                navCartCount.innerText = count;
            }
        }

        async function addToCart(productId) {
            const qtyInput = document.getElementById('qty_' + productId);
            const quantity = qtyInput ? parseInt(qtyInput.value, 10) || 1 : 1;
            const token = getRequestVerificationToken();

            try {
                const form = new URLSearchParams();
                form.append('productId', productId);
                form.append('quantity', quantity);
                form.append('__RequestVerificationToken', token);

                const resp = await fetch('@Url.Page(null, "AddToCart")', {
                    method: 'POST',
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: form
                });

                if (!resp.ok) {
                    throw new Error(`Error HTTP: ${resp.status}`);
                }

                const json = await resp.json();

                if (json.success) {
                    updateCartCount(json.cartCount);

                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'success',
                        title: json.message,
                        showConfirmButton: false,
                        timer: 2000
                    });
                } else {
                    Swal.fire('Error', json.message || 'No se pudo añadir al carrito', 'error');
                }
            } catch (ex) {
                console.error(ex);
                Swal.fire('Error', 'Error al comunicarse con el servidor: ' + ex.message, 'error');
            }
        }

        // Auto-submit del formulario cuando cambian los filtros
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('filterForm');
            const selects = form.querySelectorAll('select');

            selects.forEach(select => {
                select.addEventListener('change', function() {
                    form.submit();
                });
            });

            // Búsqueda con Enter
            const searchInput = document.querySelector('input[name="SearchQuery"]');
            if (searchInput) {
                searchInput.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        form.submit();
                    }
                });
            }
        });
    </script>
}