@page
@model AutoPartesRazor.Pages.Products.IndexModel

@{
    ViewData["Title"] = "Lista de productos";
}

@if (TempData["SuccessMessage"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            Swal.fire({
                title: '¡Éxito!',
                text: '@TempData["SuccessMessage"]',
                icon: 'success',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer);
                    toast.addEventListener('mouseleave', Swal.resumeTimer);
                }
            });
        });
    </script>
}
<h1>Lista de productos</h1>


<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="SearchString" value="@Model.SearchProduct" placeholder="Nombre del producto...." class="form-control w-50" />
        <button type="submit" class="btn btn-success m-2">Buscar</button>
        <a asp-page="./Index" class="btn btn-secondary m-2">Limpiar</a>
    </div>
 </form>

<p>
    <a asp-page="Create" class="btn btn-secondary">Nuevo producto</a>
</p>

@if (Model.Product.Any())
{
    <table class="table table-dark table-bordered">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Cantidad</th>
                <th>Precio</th>
                <th>Categoría</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
    @foreach (var item in Model.Product) {
            <tr>
                <td>@item.name</td>
                <td>@item.stock</td>
                <td>@item.price.ToString("C")</td>
                <td>@item.Category.name</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.id" class="btn btn-primary btn-sm position-relative me-2">
                        <i class="fa-regular fa-pen-to-square"></i>
                    </a> |
                    <a asp-page="./Details" asp-route-id="@item.id" class="btn btn-secondary btn-sm position-relative me-2">
                        <i class="fa-brands fa-phabricator"></i>
                    </a> |
                    <button type="button" class="btn btn-danger btn-sm position-relative me-2"
                                onclick="confirmDelete(@item.id, '@Html.Raw("Products")', '@Html.Raw("producto")', '@Html.Raw(item.name)')">
                            <i class="fa-solid fa-trash"></i>
                    </button>

                        <!-- Modal de confirmación -->
                        <div class="modal fade" id="deleteModal_@item.id" tabindex="-1" aria-labelledby="deleteModalLabel_@item.id" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="deleteModalLabel_@item.id">Confirmar eliminación</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        ¿Está seguro que desea eliminar al producto <strong>@item.name</strong>?
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary m-2" data-bs-dismiss="modal">Cancelar</button>
                                        <form method="post" asp-page="./Delete" asp-route-id="@item.id" style="display:inline;">
                                            <input type="hidden" name="id" value="@item.id" />
                                            <button type="submit" class="btn btn-danger">Eliminar</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                </td>
            </tr>
    }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning">No se encontraron productos.</div>
}

