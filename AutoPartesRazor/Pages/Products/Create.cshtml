@page
@model AutoPartesRazor.Pages.Products.CreateModel

@{
    ViewData["Title"] = "Crear producto";
}
<div class="hero-section bg-primary bg-gradient text-white py-3 text-center">
    <div class="container py-4">
        <h1 class="display-4 fw-bold mb-3">Nuevo producto</h1>
        <h4 class="lead">Datos del producto</h4>
    </div>
</div>

<hr />
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card bg-dark text-white mb-3 shadow-sm border-0">
                <div class="card-body p-4">
                    <form method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="mb-4">
                            <label asp-for="Product.Name" class="control-label "></label>
                            <input asp-for="Product.Name" class="form-control" />
                            <span asp-validation-for="Product.Name" class="text-danger"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Product.Description" class="control-label "></label>
                            <textarea asp-for="Product.Description" class="form-control" rows="4" placeholder="Una breve descripción del producto"></textarea>
                            <span asp-validation-for="Product.Description" class="text-danger"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Product.Stock" class="control-label "></label>
                            <input asp-for="Product.Stock" class="form-control" />
                            <span asp-validation-for="Product.Stock" class="text-danger"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Product.Price" class="control-label "></label>
                            <input type="number" asp-for="Product.Price" class="form-control" />
                            <span asp-validation-for="Product.Price" class="text-danger"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Product.Category.Name" class="control-label "></label>
                            <select asp-for="Product.CategoryId" class="form-select"
                                    asp-items="Model.Categories">
                                <option value="">-- Seleccione una categoría --</option>
                            </select>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Product.Brand.Name" class="control-label "></label>
                            <select asp-for="Product.BrandId" class="form-select"
                                    asp-items="Model.Brands">
                                <option value="">-- Seleccione una marca --</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="control-label">Imagen del producto</label>
                            <input type="file" asp-for="ImageFile" class="form-control" />
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-between mt-4 pt-3 border-top">
                            <input type="submit" value="Crear" class="btn btn-primary" />
                            <a asp-page="/Administration/AdminDashboard" class="btn btn-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
