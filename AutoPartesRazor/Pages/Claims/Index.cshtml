@page
@model AutoPartesRazor.Pages.Reclamos.IndexModel
@{
    ViewData["Title"] = "Mis Reclamos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            Mis Reclamos
        </h1>
        <a asp-page="./Crear" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Nuevo Reclamo
        </a>
    </div>

    @if (Model.MensajeExito != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@Model.MensajeExito
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Reclamos == null || !Model.Reclamos.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            No tienes reclamos registrados. Haz clic en "Nuevo Reclamo" para crear uno.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Ticket</th>
                                <th>Pedido</th>
                                <th>Asunto</th>
                                <th>Estado</th>
                                <th>Urgencia</th>
                                <th>Fecha</th>
                                <th>Mensajes</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reclamo in Model.Reclamos)
                            {
                                <tr>
                                    <!-- TICKET -->
                                    <td>
                                        <strong class="text-primary">@reclamo.NumeroTicket</strong>
                                    </td>

                                    <!-- PEDIDO (MODIFICADO) -->
                                    <td>
                                        @if (reclamo.OrderId != null)
                                        {
                                            <span class="badge bg-info">
                                                <i class="bi bi-box me-1"></i>#@reclamo.OrderId
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                <small>General</small>
                                            </span>
                                        }
                                    </td>

                                    <!-- ASUNTO -->
                                    <td>
                                        <div class="text-truncate" style="max-width: 300px;">
                                            @reclamo.Asunto
                                        </div>
                                    </td>

                                    <!-- ESTADO -->
                                    <td>
                                        @switch (reclamo.Estado)
                                        {
                                            case AutoPartesRazor.Models.Enum.StatusClaim.Nuevo:
                                                <span class="badge bg-info">
                                                    <i class="bi bi-star-fill me-1"></i>Nuevo
                                                </span>
                                                break;
                                            case AutoPartesRazor.Models.Enum.StatusClaim.EnProceso:
                                                <span class="badge bg-warning text-dark">
                                                    <i class="bi bi-hourglass-split me-1"></i>En Proceso
                                                </span>
                                                break;
                                            case AutoPartesRazor.Models.Enum.StatusClaim.Respondido:
                                                <span class="badge bg-primary">
                                                    <i class="bi bi-chat-dots-fill me-1"></i>Respondido
                                                </span>
                                                break;
                                            case AutoPartesRazor.Models.Enum.StatusClaim.Resuelto:
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Resuelto
                                                </span>
                                                break;
                                            case AutoPartesRazor.Models.Enum.StatusClaim.Cerrado:
                                                <span class="badge bg-secondary">
                                                    <i class="bi bi-lock-fill me-1"></i>Cerrado
                                                </span>
                                                break;
                                        }
                                    </td>

                                    <!-- URGENCIA -->
                                    <td>
                                        @switch (reclamo.NivelUrgencia)
                                        {
                                            case AutoPartesRazor.Models.Enum.LevelUrgency.Baja:
                                                <span class="badge bg-light text-dark">Baja</span>
                                                break;
                                            case AutoPartesRazor.Models.Enum.LevelUrgency.Media:
                                                <span class="badge bg-secondary">Media</span>
                                                break;
                                            case AutoPartesRazor.Models.Enum.LevelUrgency.Alta:
                                                <span class="badge bg-warning text-dark">Alta</span>
                                                break;
                                            case AutoPartesRazor.Models.Enum.LevelUrgency.Critica:
                                                <span class="badge bg-danger">Crítica</span>
                                                break;
                                        }
                                    </td>

                                    <!-- FECHA -->
                                    <td>
                                        <small>@reclamo.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</small>
                                    </td>

                                    <!-- MENSAJES SIN LEER -->
                                    <td>
                                        @if (reclamo.MensajesSinLeerCliente > 0)
                                        {
                                            <span class="badge bg-danger rounded-pill">
                                                @reclamo.MensajesSinLeerCliente nuevos
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                <i class="bi bi-check-all"></i> Al día
                                            </span>
                                        }
                                    </td>

                                    <!-- ACCIONES -->
                                    <td>
                                        <a asp-page="./Detalle" asp-route-id="@reclamo.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye me-1"></i>Ver
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <p class="text-muted">
                <i class="bi bi-info-circle me-1"></i>
                Total de reclamos: <strong>@Model.Reclamos.Count</strong>
            </p>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Auto-cerrar alertas después de 5 segundos
        setTimeout(function() {
            $('.alert').fadeOut('slow');
        }, 5000);
    </script>
}