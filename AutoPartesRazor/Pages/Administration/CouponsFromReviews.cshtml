@page
@model AutoPartesRazor.Pages.Administration.CouponsFromReviewsModel
@{
    ViewData["Title"] = "Cupones por Reseñas Negativas";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                <i class="fa-solid fa-ticket text-primary me-2"></i>
                Cupones por Reseñas Negativas
            </h2>
            @if (!string.IsNullOrEmpty(Model.ProductName))
            {
                <p class="text-muted mb-0">
                    Filtrando por producto: <strong class="text-primary">@Model.ProductName</strong>
                </p>
            }
            else
            {
                <p class="text-muted mb-0">Compensa a usuarios con malas experiencias</p>
            }
        </div>
        <div class="d-flex gap-2">
            @if (Model.ProductId.HasValue)
            {
                <a asp-page="/Administration/CouponsFromReviews" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-filter-circle-xmark me-1"></i>Ver Todos
                </a>
            }
            <a asp-page="/Administration/ReviewsDashboard" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i>Volver
            </a>
            <a asp-page="/Administration/ManageCoupons" class="btn btn-info">
                <i class="fa-solid fa-list me-1"></i>Ver Todos los Cupones
            </a>
        </div>
    </div>

    <!-- Mensajes -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fa-solid fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fa-solid fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Estadísticas -->
    @if (!string.IsNullOrEmpty(Model.ProductName))
    {
        <div class="alert alert-info mb-4">
            <i class="fa-solid fa-info-circle me-2"></i>
            <strong>Filtrado activo:</strong> Mostrando solo reseñas negativas del producto
            <strong>@Model.ProductName</strong>.
            <a asp-page="/Administration/CouponsFromReviews" class="alert-link">Ver todas las reseñas</a>
        </div>
    }

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h6 class="text-uppercase mb-2">Usuarios Elegibles</h6>
                    <h2 class="mb-0">@Model.TotalEligibleUsers</h2>
                    <small>Con reseñas negativas</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-warning text-dark">
                <div class="card-body">
                    <h6 class="text-uppercase mb-2">Reseñas Negativas</h6>
                    <h2 class="mb-0">@Model.EligibleReviews.Count</h2>
                    <small>Pendientes de cupón</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-danger text-white">
                <div class="card-body">
                    <h6 class="text-uppercase mb-2">Descuento Potencial</h6>
                    <h2 class="mb-0">@Model.PotentialDiscountValue%</h2>
                    <small>Total acumulado</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de Reseñas Elegibles -->
    @if (!Model.EligibleReviews.Any())
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="fa-solid fa-smile fa-3x text-success mb-3"></i>
                @if (!string.IsNullOrEmpty(Model.ProductName))
                {
                    <h5 class="text-muted">¡Excelente! No hay reseñas negativas para este producto</h5>
                    <p class="text-muted">El producto <strong>@Model.ProductName</strong> no tiene clientes insatisfechos.</p>
                }
                else
                {
                    <h5 class="text-muted">¡Excelente! No hay reseñas negativas pendientes</h5>
                    <p class="text-muted">Todos tus clientes están satisfechos o ya tienen cupones de compensación.</p>
                }
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header bg-white py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fa-solid fa-users me-2"></i>
                        Usuarios con Reseñas Negativas
                    </h5>
                    <button type="button" class="btn btn-success" onclick="generateBulkCoupons()">
                        <i class="fa-solid fa-magic me-1"></i>
                        Generar Cupones Masivos
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <form id="bulkCouponForm" method="post" asp-page-handler="GenerateBulk">
                    <input type="hidden" name="bulkDaysValid" id="bulkDaysValid" value="30" />

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-center">
                                        <input type="checkbox" id="selectAll" class="form-check-input"
                                               onchange="toggleAllCheckboxes(this)">
                                    </th>
                                    <th>Usuario</th>
                                    <th>Producto</th>
                                    <th>Calificación</th>
                                    <th>Comentario</th>
                                    <th>Fecha</th>
                                    <th>Descuento Sugerido</th>
                                    <th>Estado</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var review in Model.EligibleReviews)
                                {
                                    <tr class="@(review.HasExistingCoupon ? "table-secondary" : "")">
                                        <td class="text-center">
                                            @if (!review.HasExistingCoupon)
                                            {
                                                <input type="checkbox" name="selectedReviews"
                                                       value="@review.ReviewId"
                                                       class="form-check-input review-checkbox">
                                            }
                                        </td>
                                        <td>
                                            <div>
                                                <strong>@review.UserName</strong><br />
                                                <small class="text-muted">@review.UserEmail</small>
                                            </div>
                                        </td>
                                        <td>
                                            <small>@review.ProductName</small>
                                        </td>
                                        <td>
                                            <span class="badge bg-danger">
                                                @for (int i = 0; i < review.Rating; i++)
                                                {
                                                    <i class="fa-solid fa-star"></i>
                                                }
                                            </span>
                                        </td>
                                        <td>
                                            <div class="text-truncate" style="max-width: 200px;">
                                                @(review.Comment ?? "Sin comentario")
                                            </div>
                                        </td>
                                        <td>
                                            <small>@review.ReviewDate.ToString("dd/MM/yyyy")</small>
                                        </td>
                                        <td>
                                            <strong class="text-danger">-@review.SuggestedDiscount%</strong>
                                        </td>
                                        <td>
                                            @if (review.HasExistingCoupon)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="fa-solid fa-check me-1"></i>
                                                    Tiene cupón: @review.ExistingCouponCode
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    <i class="fa-solid fa-clock me-1"></i>Pendiente
                                                </span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (!review.HasExistingCoupon)
                                            {
                                                <button type="button" class="btn btn-sm btn-primary"
                                                        onclick="openCouponModal(@review.ReviewId, '@review.UserName', '@review.ProductName', @review.SuggestedDiscount)">
                                                    <i class="fa-solid fa-ticket me-1"></i>Generar
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-secondary" disabled>
                                                    <i class="fa-solid fa-check"></i>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </form>
            </div>
        </div>
    }
</div>

<!-- Modal Generar Cupón Individual -->
<div class="modal fade" id="couponModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="GenerateSingle">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="fa-solid fa-ticket me-2"></i>Generar Cupón de Compensación
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="SelectedReviewId" id="modalReviewId" />

                    <div class="alert alert-info">
                        <strong>Usuario:</strong> <span id="modalUserName"></span><br />
                        <strong>Producto:</strong> <span id="modalProductName"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Porcentaje de Descuento</label>
                        <div class="input-group">
                            <input type="number" asp-for="CustomDiscount"
                                   id="modalDiscount"
                                   class="form-control"
                                   min="1" max="100"
                                   placeholder="Ej: 30">
                            <span class="input-group-text">%</span>
                        </div>
                        <small class="text-muted">
                            Sugerido: <strong><span id="modalSuggestedDiscount"></span>%</strong>
                        </small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Días de Validez</label>
                        <input type="number" asp-for="DaysValid" class="form-control"
                               value="30" min="1" max="365">
                        <small class="text-muted">El cupón expirará después de estos días</small>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox"
                               asp-for="ApplyToProduct" checked>
                        <label class="form-check-label">
                            Aplicar solo al producto específico
                        </label>
                        <small class="d-block text-muted">
                            Si se desmarca, el cupón se puede usar en cualquier producto
                        </small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-save me-1"></i>Generar Cupón
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openCouponModal(reviewId, userName, productName, suggestedDiscount) {
            document.getElementById('modalReviewId').value = reviewId;
            document.getElementById('modalUserName').textContent = userName;
            document.getElementById('modalProductName').textContent = productName;
            document.getElementById('modalSuggestedDiscount').textContent = suggestedDiscount;
            document.getElementById('modalDiscount').value = suggestedDiscount;

            const modal = new bootstrap.Modal(document.getElementById('couponModal'));
            modal.show();
        }

        function toggleAllCheckboxes(source) {
            const checkboxes = document.querySelectorAll('.review-checkbox');
            checkboxes.forEach(checkbox => {
                checkbox.checked = source.checked;
            });
        }

        function generateBulkCoupons() {
            const checkedBoxes = document.querySelectorAll('.review-checkbox:checked');

            if (checkedBoxes.length === 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'No hay selección',
                    text: 'Debes seleccionar al menos una reseña para generar cupones masivos.',
                    confirmButtonText: 'Entendido'
                });
                return;
            }

            Swal.fire({
                title: 'Generar Cupones Masivos',
                html: `
                    <p>Se generarán cupones para <strong>${checkedBoxes.length}</strong> usuarios.</p>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Días de validez:</label>
                        <input type="number" id="swalDaysValid" class="form-control" value="30" min="1" max="365">
                    </div>
                `,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: '<i class="fa-solid fa-check me-1"></i>Generar',
                cancelButtonText: 'Cancelar',
                preConfirm: () => {
                    const days = document.getElementById('swalDaysValid').value;
                    if (!days || days < 1) {
                        Swal.showValidationMessage('Debes especificar días válidos');
                        return false;
                    }
                    return days;
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('bulkDaysValid').value = result.value;
                    document.getElementById('bulkCouponForm').submit();
                }
            });
        }
    </script>
}