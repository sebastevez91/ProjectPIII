@page
@model AutoPartesRazor.Pages.Administration.DespachoModel

<h2 class="mb-4 fw-bold text-warning animate__animated animate__fadeInDown">
    <i class="fa-solid fa-truck"></i> Despacho de pedidos
</h2>

@if (TempData["DespachoOK"] != null)
{
    <script>
        Swal.fire({
            title: '¡Pedido en preparación!',
            text: 'El pedido fue marcado como en preparación.',
            icon: 'success',
            showConfirmButton: false,
            timer: 1300
        });
    </script>
}

<table class="table table-hover table-striped shadow-lg rounded">
    <thead class="table-dark">
        <tr class="animate__animated animate__fadeInDown">
            <th>ID</th>
            <th>Cliente</th>
            <th>Email</th>
            <th>Dirección</th>
            <th>Estado</th>
            <th>Acción</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model.PedidosPendientes)
        {
            string badgeClass = "bg-secondary";
            string anim = "animate__pulse";
            string badgeIcon = "<i class='fa-solid fa-truck-ramp-box'></i>";

            if (p.Status == "Pending") { badgeClass = "bg-warning text-dark"; badgeIcon = "<i class='fa-solid fa-clock'></i>"; }
            // Agregamos el estado "Preparando" para referencia futura si se usa esta vista para seguimiento
            else if (p.Status == "Preparando") { badgeClass = "bg-primary"; badgeIcon = "<i class='fa-solid fa-box'></i>"; anim = "animate__pulse"; }
            else if (p.Status == "Despachado") { badgeClass = "bg-success"; badgeIcon = "<i class='fa-solid fa-truck'></i>"; anim = "animate__tada"; }
            else if (p.Status == "Cancelado") { badgeClass = "bg-danger"; badgeIcon = "<i class='fa-solid fa-xmark'></i>"; }

            <tr class="align-middle animate__animated animate__fadeInUp">
                <td>@p.Id</td>
                <td>@p.CustomerName</td>
                <td>@p.CustomerEmail</td>
                <td>@p.ShippingAddress</td>
                <td>
                    <span class="badge @badgeClass px-3 py-2 animate__animated @anim" style="font-size:1em;">
                        @Html.Raw(badgeIcon) @p.Status
                    </span>
                </td>
                <td>
                    <form method="post" asp-page-handler="Preparar" asp-route-id="@p.Id" class="d-inline despachoForm" data-pid="@p.Id">
                        <button type="submit" class="btn btn-warning btn-sm shadow-sm animate__animated animate__bounceIn">
                            <i class="fa-solid fa-box-open"></i> Preparar
                        </button>
                    </form>

                    <a asp-page="/Administration/DetallePedido" asp-route-id="@p.Id"
                       class="btn btn-info btn-sm shadow-sm animate__animated animate__fadeIn">
                        <i class="fa-solid fa-magnifying-glass"></i> Ver Detalle
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        document.querySelectorAll('.despachoForm').forEach(form => {
            form.addEventListener('submit', function (event) {
                event.preventDefault();
                const formActual = this;
                Swal.fire({
                    // Texto de Confirmación Modificado
                    title: '¿Preparar pedido?',
                    text: "Esta acción marcará el pedido como en preparación.",
                    icon: 'question',
                    showCancelButton: true,
                    // Color para coincidir con btn-warning (amarillo/naranja)
                    confirmButtonColor: '#ffc107',
                    cancelButtonColor: '#d33',
                    // Texto del Botón Modificado
                    confirmButtonText: '¡Sí, preparar!',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Cambiamos el color a 'success' (verde) al confirmar para mejor UX
                        Swal.fire({
                            title: '¡Preparando!',
                            text: 'Procesando el cambio de estado...',
                            icon: 'info',
                            showConfirmButton: false,
                            timer: 500
                        }).then(() => {
                            formActual.submit();
                        });
                    }
                });
            });
        });
    </script>
}