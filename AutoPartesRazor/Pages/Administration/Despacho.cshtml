@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Lógica de confirmación para Marcar En Camino
        document.querySelectorAll('.despachoForm').forEach(form => {
            form.addEventListener('submit', function (event) {
                event.preventDefault();
                const formActual = this;
                Swal.fire({
                    title: '¿Marcar como En Camino?',
                    text: "Esta acción marcará el pedido como enviado y se notificará al cliente.",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#d33',
                    confirmButtonText: '¡Sí, Enviar!',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        formActual.submit();
                    }
                });
            });
        });

        // Lógica de confirmación para Marcar Entregado (Nuevo)
        document.querySelectorAll('.entregaForm').forEach(form => {
            form.addEventListener('submit', function (event) {
                event.preventDefault();
                const formActual = this;
                Swal.fire({
                    title: '¿Confirmar Entrega?',
                    text: "Esta es la confirmación final de que el pedido fue entregado al cliente.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#198754',
                    cancelButtonColor: '#d33',
                    confirmButtonText: '¡Sí, Entregar!',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        formActual.submit();
                    }
                });
            });
        });
    </script>
}