@page
@model AutoPartesRazor.Pages.Administration.DespachoModel

<h2 class="mb-4 fw-bold text-warning animate__animated animate__fadeInDown">
    <i class="fa-solid fa-truck"></i> Despacho de pedidos
</h2>

@* Lógica del SweetAlert para notificaciones (Sin cambios) *@
@if (TempData["DespachoOK"] != null)
{
    <script>
        Swal.fire({
            title: '¡Actualizado!',
            text: '@TempData["DespachoOK"]',
            icon: 'success',
            showConfirmButton: false,
            timer: 1500
        });
    </script>
}

<table class="table table-hover table-striped shadow-lg rounded">
    <thead class="table-dark">
        <tr class="animate__animated animate__fadeInDown">
            <th>ID</th>
            <th>Cliente</th>
            <th>Email</th>
            <th>Dirección</th>
            <th>Estado</th>
            <th>Acción</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model.PedidosPendientes)
        {
            // Lógica de colores del badge (Añadido 'En Camino' y 'Entregado')
            string badgeClass = "bg-secondary";
            string anim = "animate__pulse";
            string badgeIcon = "<i class='fa-solid fa-truck-ramp-box'></i>";

            if (p.Status == "Pending" || p.Status == "Pendiente")
            {
                badgeClass = "bg-warning text-dark";
                badgeIcon = "<i class='fa-solid fa-clock'></i>";
            }
            else if (p.Status == "Preparando")
            {
                badgeClass = "bg-info text-dark";
                badgeIcon = "<i class='fa-solid fa-box-open'></i>";
                anim = "animate__flash";
            }
            else if (p.Status == "En Camino") // NUEVO ESTADO
            {
                badgeClass = "bg-primary";
                badgeIcon = "<i class='fa-solid fa-route'></i>"; // Icono de ruta
                anim = "animate__bounceIn";
            }
            else if (p.Status == "Entregado") // NUEVO ESTADO FINAL
            {
                badgeClass = "bg-success";
                badgeIcon = "<i class='fa-solid fa-check-double'></i>";
                anim = "animate__tada";
            }
            else if (p.Status == "Cancelado")
            {
                badgeClass = "bg-danger";
                badgeIcon = "<i class='fa-solid fa-xmark'></i>";
            }

            <tr class="align-middle animate__animated animate__fadeInUp">
                <td>@p.Id</td>
                <td>@p.CustomerName</td>
                <td>@p.CustomerEmail</td>
                <td>@p.ShippingAddress</td>
                <td>
                    <span class="badge @badgeClass px-3 py-2 animate__animated @anim" style="font-size:1em;">
                        @Html.Raw(badgeIcon) @p.Status
                    </span>
                </td>
                <td>
