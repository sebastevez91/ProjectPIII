@page "{id:int}"
@model AutoPartesRazor.Pages.Administration.DetallePedidoModel

<h2 class="mb-4 fw-bold text-success animate__animated animate__fadeInLeft">
    <i class="fa-solid fa-list"></i> Detalle del Pedido
</h2>

@if (TempData["orderMessage"] != null)
{
    <script>
        Swal.fire({
            title: '¡Estado actualizado!',
            text: '@TempData["orderMessage"]',
            icon: 'success',
            showConfirmButton: false,
            timer: 1600
        });
    </script>
}

@{
    // Definimos los pasos del stepper visual
    var pasos = new List<(string Estado, string Icono, string ColorClase)>
    {
        ("Pendiente", "fa-file-lines", "bg-secondary"),
        ("Preparando", "fa-box-open", "bg-info"),
        ("Despachado", "fa-truck-loading", "bg-warning"), // Nota: Si cambiaste a "En camino" como paso único, ajusta esto.
        ("En camino", "fa-truck", "bg-primary"),
        ("Entregado", "fa-check-circle", "bg-success")
    };
    int pasoActual = pasos.FindIndex(s => s.Estado == Model.Pedido.Status);
    if (pasoActual == -1) { pasoActual = 0; }
}

<div class="stepper my-4 p-2 animate__animated animate__fadeIn">
    <div class="d-flex justify-content-between align-items-center flex-wrap">
        @for (int i = 0; i < pasos.Count; i++)
        {
            var (estado, icono, colorClase) = pasos[i];
            var alcanzado = i <= pasoActual;
            <div class="text-center flex-fill">
                <div class="step-circle @colorClase @(alcanzado ? "step-active animate__animated animate__bounce" : "step-inactive")">
                    <i class="fa-solid @(icono)"></i>
                </div>
                <div class="step-label mt-2 fw-semibold" style="font-size:1em; color:@(alcanzado ? "#18202E" : "#bbb");">
                    @estado
                </div>
            </div>
            @if (i < pasos.Count - 1)
            {
                <div class="flex-grow-1 px-1 step-line @(i < pasoActual ? "step-line-active" : "")"></div>
            }
        }
    </div>
</div>

@if (Model.Pedido != null)
{
    <div class="my-3">
        <div class="d-flex gap-2 flex-wrap">
            @if (Model.Pedido.Status == "Pendiente")
            {
                <form method="post" asp-page-handler="Preparar" asp-route-id="@Model.Pedido.Id">
                    <button type="submit" class="btn btn-info shadow-sm animate__animated animate__pulse">
                        <i class="fa-solid fa-box-open"></i> Preparar
                    </button>
                </form>
            }
            @if (Model.Pedido.Status == "Preparando")
            {
                <form method="post" asp-page-handler="Despachar" asp-route-id="@Model.Pedido.Id">
                    <button type="submit" class="btn btn-warning shadow-sm animate__animated animate__pulse">
                        <i class="fa-solid fa-truck-loading"></i> Despachar
                    </button>
                </form>
            }
            @if (Model.Pedido.Status == "Despachado")
            {
                <form method="post" asp-page-handler="EnCamino" asp-route-id="@Model.Pedido.Id">
                    <button type="submit" class="btn btn-primary shadow-sm animate__animated animate__pulse">
                        <i class="fa-solid fa-truck"></i> En camino
                    </button>
                </form>
            }
            @if (Model.Pedido.Status == "En camino")
            {
                <form method="post" asp-page-handler="Entregar" asp-route-id="@Model.Pedido.Id">
                    <button type="submit" class="btn btn-success shadow-sm animate__animated animate__pulse">
                        <i class="fa-solid fa-check-double"></i> Entregar
                    </button>
                </form>
            }
            @if (Model.Pedido.Status != "Entregado" && Model.Pedido.Status != "Cancelado")
            {
                <form method="post" asp-page-handler="Cancelar" asp-route-id="@Model.Pedido.Id">
                    <button type="submit" class="btn btn-danger shadow-sm animate__animated animate__shakeX">
                        <i class="fa-solid fa-ban"></i> Cancelar
                    </button>
                </form>
            }
    </div>
</div>

<div>
    <a asp-page="/Orders/Confirmation" class="btn btn-primary m-2" asp-route-id="@Model.Pedido.Id">
        <i class="fa-solid fa-file-invoice"></i> Ver recibo
    </a>
</div>

<table class="table table-hover table-striped shadow rounded animate__animated animate__fadeInUp">
    <tr>
        <td><b>ID:</b></td>
        <td>@Model.Pedido.Id</td>
    </tr>
    <tr>
        <td><b>Cliente:</b></td>
        <td>@Model.Pedido.CustomerName</td>
    </tr>
    <tr>
        <td><b>Email:</b></td>
        <td>@Model.Pedido.CustomerEmail</td>
    </tr>
    <tr>
        <td><b>Estado:</b></td>
        <td>
            <span class="badge
                    @(Model.Pedido.Status == "Pendiente" ? "bg-warning text-dark animate__animated animate__pulse" :
                                        Model.Pedido.Status == "Despachado" ? "bg-success animate__animated animate__tada" :
                                        Model.Pedido.Status == "Preparando" ? "bg-info animate__animated animate__flash" :
                                        Model.Pedido.Status == "En camino" ? "bg-primary animate__animated animate__heartBeat" :
                                        Model.Pedido.Status == "Entregado" ? "bg-success animate__animated animate__bounce" :
                                        "bg-secondary") px-3">
                    <i class='fa-solid fa-info-circle'></i> @Model.Pedido.Status
                </span>
            </td>
        </tr>
        <tr>
            <td><b>Dirección:</b></td>
            <td>@Model.Pedido.ShippingAddress</td>
        </tr>
        <tr>
            <td><b>Total:</b></td>
            <td>$@Model.Pedido.Total</td>
        </tr>
    </table>

    <h4 class="mt-4"><i class="fa-solid fa-box"></i> Productos</h4>
    <ul class="list-group shadow-sm animate__animated animate__fadeInUp">
        @foreach (var item in Model.Pedido.Items)
        {
            <li class="list-group-item">
                <b>@item.Product?.Name</b> - @item.Quantity x $@item.UnitPrice
            </li>
        }
    </ul>

    @if (Model.Pedido.Status == "Entregado")
    {
        <div class="row mt-4 animate__animated animate__fadeInUp">

            <div class="col-md-12 mb-3">
                <div class="alert @(Model.Pedido.ClientConfirmed ? "alert-success" : "alert-warning") shadow-sm border-0">
                    <h5 class="alert-heading">
                        <i class="fa-solid @(Model.Pedido.ClientConfirmed ? "fa-circle-check" : "fa-hourglass-half")"></i>
                        Confirmación de Recepción
                    </h5>
                    <hr>
                    @if (Model.Pedido.ClientConfirmed)
                    {
                        <p class="mb-0">
                            ✅ <strong>El cliente ha confirmado la recepción</strong>.
                            <br>
                            <small class="text-muted">
                                (Fecha de confirmación: @(Model.Pedido.DeliveryDate.HasValue? Model.Pedido.DeliveryDate.Value.ToString("dd/MM/yyyy HH:mm") : "Recientemente"))
                            </small>
                        </p>
                    }
                    else
                    {
                        <p class="mb-0">
                            ⏳ <strong>Esperando confirmación del cliente.</strong>
                            <br>
                            Se ha enviado un correo electrónico solicitando la confirmación.
                        </p>
                    }
                </div>
            </div>

            <div class="col-md-12">
                <div class="alert alert-info shadow-sm border-0">
                    <h5 class="alert-heading"><i class="fa-solid fa-star"></i> Opinión del cliente</h5>
                    <hr>
                    @if (Model.Pedido.Calificacion != null)
                    {
                        <span>
                            <strong>Calificación:</strong>&nbsp;
                            @for (int star = 1; star <= 5; star++)
                            {
                                <span style="font-size:1.3em; color:@(star <= Model.Pedido.Calificacion ? "#fcc419" : "#ccd1d1");">★</span>
                            }
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">El cliente aún no ha calificado este pedido.</span>
                    }
                </div>
            </div>

        </div>
    }

    <div class="mt-4">
        <a asp-page="/Administration/Despacho"
           class="btn btn-outline-primary btn-lg shadow-sm animate__animated animate__fadeInUp">
            <i class="fa-solid fa-arrow-left"></i> Volver al despacho
        </a>
    </div>
}
else
{
    <div class="alert alert-danger">Pedido no encontrado.</div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function abrirMensajeCliente(email) {
            Swal.fire({
                title: 'Enviar mensaje al cliente',
                input: 'textarea',
                inputLabel: 'Mensaje a ' + email,
                inputPlaceholder: 'Escribe tu mensaje aquí...',
                showCancelButton: true,
                confirmButtonText: 'Enviar',
                cancelButtonText: 'Cancelar'
                // ... resto de tu lógica JS
            });
        }
    </script>
}