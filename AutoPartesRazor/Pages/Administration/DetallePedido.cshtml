<h2 class="mb-4 fw-bold text-success animate__animated animate__fadeInLeft">
    <i class="fa-solid fa-list"></i> Detalle del Pedido
</h2>

@if (TempData["orderMessage"] != null)
{
    <script>
        Swal.fire({
            title: '¡Estado actualizado!',
            text: '@TempData["orderMessage"]',
            icon: 'success',
            showConfirmButton: false,
            timer: 1600
        });
    </script>
}

@{
    var pasos = new List<(string Estado, string Icono, string ColorClase)>
    {
        ("Pendiente", "fa-file-lines", "bg-secondary"),
        ("Preparando", "fa-box-open", "bg-info"),
        ("Despachado", "fa-truck-loading", "bg-warning"),
        ("En camino", "fa-truck", "bg-primary"),
        ("Entregado", "fa-check-circle", "bg-success")
    };
    int pasoActual = pasos.FindIndex(s => s.Estado == Model.Pedido.Status);
    if (pasoActual == -1) { pasoActual = 0; }
}

<div class="stepper my-4 p-2 animate__animated animate__fadeIn">
    <div class="d-flex justify-content-between align-items-center flex-wrap">
        @for (int i = 0; i < pasos.Count; i++)
        {
            var (estado, icono, colorClase) = pasos[i];
            var alcanzado = i <= pasoActual;
            <div class="text-center flex-fill">
                <div class="step-circle @colorClase @(alcanzado ? "step-active animate__animated animate__bounce" : "step-inactive")">
                    <i class="fa-solid @(icono)"></i>
                </div>
                <div class="step-label mt-2 fw-semibold" style="font-size:1em; color:@(alcanzado ? "#18202E" : "#bbb");">
                    @estado
                </div>
            </div>
            @if (i < pasos.Count - 1)
            {
                <div class="flex-grow-1 px-1 step-line @(i < pasoActual ? "step-line-active" : "")"></div>
            }
        }
    </div>
</div>

