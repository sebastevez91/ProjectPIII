@model IEnumerable<AutoPartesRazor.Models.Brand>

@if(Model != null && Model.Any())
{
    <table class="table table-hover shadow-sm table-primary table-striped fs-6">
        <thead class="table-dark">
            <tr>
                <th>Nombre de Marca</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var brand in Model)
            {
                <tr>
                    <td>@brand.Name</td>
                    <td>
                        <a asp-page="/Brands/Edit" asp-route-id="@brand.Id" class="btn btn-success btn-sm me-2" title="Editar">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </a>
                        <a asp-page="/Brands/Delete" asp-route-id="@brand.Id" class="btn btn-danger btn-sm" title="Eliminar">
                            <i class="fa-solid fa-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning">No se encontraron marcas.</div>
}