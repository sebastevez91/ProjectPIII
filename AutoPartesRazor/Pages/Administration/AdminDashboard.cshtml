<div class="container py-4">
    <h2 class="mb-4">Panel de Administración</h2>

    <div class="mb-3 d-flex flex-wrap gap-2">
        <!-- ⬇️ NUEVO BOTÓN DE RESEÑAS ⬇️ -->
        <button class="btn btn-warning btn-sm" onclick="location.href='@Url.Page("/Administration/ReviewsDashboard")'">
            <i class="fa-solid fa-star"></i> Dashboard de Reseñas
        </button>

        <button class="btn btn-primary btn-sm" onclick="toggleSection('notificationSection')">
            <i class="fa-solid fa-envelope"></i> Ver Notificaciones
        </button>
        <button class="btn btn-primary btn-sm" onclick="toggleSection('orderSection')">
            <i class="fa-solid fa-book"></i> Ver Órdenes
        </button>
        <button class="btn btn-primary btn-sm" onclick="toggleSection('usersSection')">
            <i class="fa-solid fa-users"></i> Gestionar Usuarios
        </button>
        <button class="btn btn-primary btn-sm" onclick="toggleSection('productsSection')">
            <i class="fa-solid fa-list-check"></i> Gestionar Productos
        </button>
        <button class="btn btn-primary btn-sm" onclick="toggleSection('inventarioSection')">
            Gestion inventario
        </button>

        @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
        {
            <button class="btn btn-success btn-sm" style="min-width:220px;" onclick="location.href='@Url.Page("/Administration/Despacho")'">
                <i class="fa-solid fa-truck"></i> Despacho de pedidos
            </button>
        }
    </div>

    <!-- Sección de Productos -->
    <div id="productsSection" class="mt-4" style="display:none;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">Listado de Productos</h3>
            <div>
                <a asp-page="/Products/Create" class="btn btn-primary">Nuevo producto</a>
                <button class="btn btn-primary ms-2" onclick="toggleSection('categoriesSection')">Categorías</button>
                <button class="btn btn-primary ms-2" onclick="toggleSection('brandSection')">Marcas</button>
            </div>
        </div>
        <partial name="_ProductsTable" model="Model.Products" />

        <!-- Sección de Categorías -->
        <div id="categoriesSection" style="display:none;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="mb-0">Listado de Categorías</h3>
                <a asp-page="/Categories/Create" class=" btn btn-primary">Nueva categoría</a>
            </div>
            <partial name="_CategoriesTable" model="Model.Categories" />
        </div>

        <!-- Sección de Marcas -->
        <div id="brandSection" style="display:none;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="mb-0">Listado de Marcas</h3>
                <a asp-page="/Brands/Create" class=" btn btn-primary m-2">Nueva marca</a>
            </div>
            <partial name="_BrandTable" model="Model.Brands" />
        </div>
    </div>

    <!-- Sección de Usuarios -->
    <div id="usersSection" class="mt-4" style="display:none;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">Listado de Usuarios</h3>
            <a asp-page="/Users/Create" class="btn btn-primary">Nuevo usuario</a>
        </div>
        <partial name="_UsersTable" model="Model.Users" />
    </div>

    <!-- Sección de Órdenes -->
    <div id="orderSection" class="mt-4" style="display:none;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">Listado de Órdenes</h3>
        </div>
        <partial name="_OrdenesTable" model="Model.Orders" />
    </div>

    <!-- Sección de Notificaciones -->
    <div id="notificationSection" class="mt-4" style="display:none;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">Listado de Notificaciones</h3>
        </div>
        <form method="get" class="d-flex mb-3 gap-2">
            <input type="text" name="OrderId" class="form-control" placeholder="Filtrar por ID Pedido" style="max-width:200px;" />
            <button type="submit" class="btn btn-secondary btn-sm">Filtrar</button>
        </form>
        <partial name="_NotificationTable" model="Model.Notifications" />
    </div>

    <!-- Sección de Inventario -->
    <div id="inventarioSection" class="mt-4" style="display:none;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">Inventario</h3>
        </div>
        <a asp-page="/Suppliers/Index" class="btn btn-primary btn-sm m-1">Proveédores</a>
        <a asp-page="/PurchaseOrders/Index" class="btn btn-primary btn-sm m-1">Orden de pedidos</a>
        <button class="btn btn-danger btn-sm" onclick="toggleSection('lowStockSection')">
            <i class="fa-solid fa-triangle-exclamation"></i>Productos stock bajo
        </button>
    </div>

    <!-- Sección Stock Bajo -->
    <div id="lowStockSection" class="mt-4" style="display:none;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0 text-danger">Productos con Stock Bajo</h3>
        </div>

        @if (Model.LowStockProducts.Count == 0)
        {
            <p class="text-success">No hay productos con stock bajo 🎉</p>
        }
        else
        {
            <table class="table table-bordered">
                <thead class="table-danger">
                    <tr>
                        <th>Producto</th>
                        <th>Descripción</th>
                        <th>Stock</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.LowStockProducts)
                    {
                        <tr>
                            <td>@p.name</td>
                            <td>@p.description</td>
                            <td><strong>@p.stock</strong></td>
                            <td>
                                <a asp-page="/PurchaseOrders/Create" asp-route-productId="@p.id"
                                   class="btn btn-success btn-sm">
                                    Crear Orden de Pedido
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@section Scripts {
    <script>
        function toggleSection(id) {
            const el = document.getElementById(id);
            el.style.display = el.style.display === 'none' ? 'block' : 'none';
        }
    </script>
