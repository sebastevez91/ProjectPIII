@model IEnumerable<AutoPartesRazor.Models.Category>

@if (Model != null && Model.Any()){
    <table class="table table-hover shadow-sm table-primary table-striped fs-6">
        <thead class="table-dark">
            <tr>
                <th>Nombre de Categoría</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var category in Model)
            {
                <tr>
                    <td>@category.name</td>
                    <td>
                        <a asp-page="/Categories/Edit" asp-route-id="@category.id" class="btn btn-success btn-sm me-2" title="Editar">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </a>
                        <a asp-page="/Categories/Delete" asp-route-id="@category.id" class="btn btn-danger btn-sm" title="Eliminar">
                            <i class="fa-solid fa-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning">No se encontraron categorías.</div>
}
