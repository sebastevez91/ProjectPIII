@page
@model AutoPartesRazor.Pages.Users.IndexModel

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                <i class="fas fa-users text-primary me-2"></i>
                Gestión de Usuarios
            </h2>
            <p class="text-muted mb-0">Administra los usuarios del sistema</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="/Administration/AdminDashboard" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i>Volver
            </a>
            <a asp-page="/Users/Create" class="btn btn-primary">
                <i class="fas fa-user-plus me-1"></i>Nuevo Usuario
            </a>
        </div>
    </div>

    <!-- Filtros -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        <i class="fas fa-search me-1"></i>Buscar
                    </label>
                    <input type="text"
                           name="searchString"
                           class="form-control"
                           placeholder="Nombre o email..."
                           value="@Model.SearchString">
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">
                        <i class="fas fa-user-tag me-1"></i>Rol
                    </label>
                    <select name="roleFilter" class="form-select" asp-items="Model.RoleList">
                        <option value="">Todos los roles</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">
                        <i class="fas fa-filter me-1"></i>Estado
                    </label>
                    <select name="statusFilter" class="form-select">
                        <option value="">Todos</option>
                        <option value="active">Activos</option>
                        <option value="inactive">Inactivos</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search me-1"></i>Filtrar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Mensajes -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Tabla de Usuarios -->
    @if (Model.Users != null && Model.Users.Any())
    {
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-semibold">
                        <i class="fas fa-list me-2 text-primary"></i>
                        Lista de Usuarios (@Model.Users.Count)
                    </h5>
                    <div class="text-muted small">
                        Total: @Model.TotalUsers usuarios registrados
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">
                                    <i class="fas fa-user me-1"></i>Usuario
                                </th>
                                <th>
                                    <i class="fas fa-envelope me-1"></i>Email
                                </th>
                                <th>
                                    <i class="fas fa-user-tag me-1"></i>Rol
                                </th>
                                <th>
                                    <i class="fas fa-calendar me-1"></i>Registro
                                </th>
                                <th class="text-center">
                                    <i class="fas fa-toggle-on me-1"></i>Estado
                                </th>
                                <th class="text-center" style="width: 180px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.Users)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(user.ProfilePicturePath))
                                            {
                                                <img src="@user.ProfilePicturePath"
                                                     alt="@user.FullName"
                                                     class="rounded-circle me-2"
                                                     style="width: 40px; height: 40px; object-fit: cover;">
                                            }
                                            else
                                            {
                                                <div class="avatar-placeholder me-2">
                                                    @user.FullName?.Substring(0, 1).ToUpper()
                                                </div>
                                            }
                                            <div>
                                                <div class="fw-semibold">@user.FullName</div>
                                                <small class="text-muted">@user.UserName</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <a href="mailto:@user.Email" class="text-decoration-none">
                                            @user.Email
                                        </a>
                                    </td>
                                    <td>
                                        <span class="badge @GetRoleBadgeClass(user.Role)">
                                            @GetRoleText(user.Role)
                                        </span>
                                    </td>
                                    <td>
                                        <small>@user.RegistrationDate.ToString("dd/MM/yyyy")</small>
                                    </td>
                                    <td class="text-center">
                                        @{
                                            bool isLocked = user.LockoutEnd.HasValue && user.LockoutEnd > DateTimeOffset.UtcNow;
                                        }
                                        @if (!isLocked)
                                        {
                                            <span class="badge bg-success-soft text-success">
                                                <i class="fas fa-check-circle me-1"></i>Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-soft text-danger">
                                                <i class="fas fa-ban me-1"></i>Bloqueado
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-page="./Details"
                                               asp-route-id="@user.Id"
                                               class="btn btn-sm btn-outline-info"
                                               title="Ver detalles">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-page="./Edit"
                                               asp-route-id="@user.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Editar">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button type="button"
                                                    class="btn btn-sm @(isLocked ? "btn-outline-success" : "btn-outline-danger")"
                                                    onclick="confirmToggle('@user.Id', '@user.FullName', @isLocked.ToString().ToLower())"
                                                    title="@(isLocked ? "Habilitar" : "Deshabilitar")">
                                                <i class="fas @(isLocked ? "fa-check" : "fa-ban")"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="fas fa-users fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">No se encontraron usuarios</h5>
                <p class="text-muted">Intenta ajustar los filtros de búsqueda o agrega un nuevo usuario.</p>
                <a asp-page="/Users/Create" class="btn btn-primary mt-3">
                    <i class="fas fa-user-plus me-1"></i>Crear Primer Usuario
                </a>
            </div>
        </div>
    }
</div>

@functions {
    string GetRoleBadgeClass(string role)
    {
        return role switch
        {
            "Admin" => "bg-danger",
            "Employee" => "bg-primary",
            "Client" => "bg-success",
            _ => "bg-secondary"
        };
    }

    string GetRoleText(string role)
    {
        return role switch
        {
            "Admin" => "Administrador",
            "Employee" => "Empleado",
            "Client" => "Cliente",
            _ => role
        };
    }
}

@section Scripts {
    <script>
        function confirmToggle(userId, userName, isLocked) {
            const action = isLocked ? 'habilitar' : 'deshabilitar';
            const actionCap = isLocked ? 'Habilitar' : 'Deshabilitar';

            Swal.fire({
                title: `¿${actionCap} usuario?`,
                html: `¿Estás seguro de ${action} a <strong>${userName}</strong>?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: isLocked ? '#28a745' : '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: `<i class="fas fa-${isLocked ? 'check' : 'ban'} me-1"></i>Sí, ${action}`,
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    const form = document.createElement('form');
                    form.method = 'POST';
                    form.action = '?handler=Delete&id=' + userId;

                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    const tokenInput = document.createElement('input');
                    tokenInput.type = 'hidden';
                    tokenInput.name = '__RequestVerificationToken';
                    tokenInput.value = token;

                    form.appendChild(tokenInput);
                    document.body.appendChild(form);
                    form.submit();
                }
            });
        }
    </script>
}

@section Styles {
    <style>
        .avatar-placeholder {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 1rem;
        }

        .bg-success-soft {
            background-color: #d1f2eb;
        }

        .bg-warning-soft {
            background-color: #ef0000;
        }

        .table > tbody > tr:hover {
            background-color: #f8f9fa;
        }

        .btn-group .btn {
            border-radius: 0;
        }

            .btn-group .btn:first-child {
                border-top-left-radius: 0.25rem;
                border-bottom-left-radius: 0.25rem;
            }

            .btn-group .btn:last-child {
                border-top-right-radius: 0.25rem;
                border-bottom-right-radius: 0.25rem;
            }

        .card {
            border: none;
        }
    </style>
}