@page
@model AutoPartesRazor.Pages.Clients.EditModel

@{
    ViewData["Title"] = "Editar cliente";
}

@if (TempData["SuccessMessage"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            Swal.fire({
                title: '¡Éxito!',
                text: '@TempData["SuccessMessage"]',
                icon: 'success',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true
            });
        });
    </script>
}

<h2>Editar Cliente</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <input type="hidden" asp-for="Client.Id" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Client.Name" class="form-label"></label>
                <input asp-for="Client.Name" class="form-control" />
                <span asp-validation-for="Client.Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Client.LastName" class="form-label"></label>
                <input asp-for="Client.LastName" class="form-control" />
                <span asp-validation-for="Client.LastName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Client.Address" class="form-label"></label>
                <input asp-for="Client.Address" class="form-control" />
                <span asp-validation-for="Client.Address" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Client.Phone" class="form-label"></label>
                <input asp-for="Client.Phone" class="form-control" placeholder="Ej: 1123456789" />
                <span asp-validation-for="Client.Phone" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Client.Email" class="form-label"></label>
                <input asp-for="Client.Email" class="form-control" />
                <span asp-validation-for="Client.Email" class="text-danger"></span>
            </div>

            <div class="form-group text-center m-4">
                <button type="submit" class="btn btn-primary btn-lg">Guardar</button>
                <a asp-page="Index" class="btn btn-secondary btn-lg">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}