@page
@model AutoPartesRazor.Pages.Clients.IndexModel

@{
    ViewData["Title"] = "Clientes";
}

@if (TempData["SuccessMessage"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            Swal.fire({
                title: '¡Éxito!',
                text: '@TempData["SuccessMessage"]',
                icon: 'success',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer);
                    toast.addEventListener('mouseleave', Swal.resumeTimer);
                }
            });
        });
    </script>
}

<h2>Clientes</h2>

<p>
    <a asp-page="Create" class="btn btn-success">Crear Nuevo Cliente</a>
</p>

<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="SearchString" value="@Model.CurrentFilter" class="form-control" placeholder="Buscar por nombre, apellido o email..." />
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
        <a asp-page="./Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

@if (Model.ClientList.Any())
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Dirección</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ClientList)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.LastName</td>
                    <td>@item.Address</td>
                    <td>@item.Phone</td>
                    <td>@item.Email</td>
                    <td>
                        <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Ver</a>
                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a>

                        <!-- Botón que llama a la función de confirmación -->
                        <button type="button" class="btn btn-danger btn-sm" onclick="confirmDelete(@item.Id, '@Html.Raw(item.Name) @Html.Raw(item.LastName)')">
                            Eliminar
                        </button>

                        <!-- Modal de confirmación -->
                        <div class="modal fade" id="deleteModal_@item.Id" tabindex="-1" aria-labelledby="deleteModalLabel_@item.Id" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="deleteModalLabel_@item.Id">Confirmar eliminación</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        ¿Está seguro que desea eliminar al cliente <strong>@item.Name @item.LastName</strong>?
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                        <form method="post" asp-page="./Delete" asp-route-id="@item.Id" style="display:inline;">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-danger">Eliminar</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning">No se encontraron clientes.</div>
}

@section Scripts {
    <script>
        function confirmDelete(id, fullName) {
            Swal.fire({
                title: '¿Estás seguro?',
                html: `¿Deseas eliminar al cliente <strong>${fullName}</strong>? Esta acción no se puede deshacer.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar',
                reverseButtons: true,
                customClass: {
                    confirmButton: 'btn btn-danger',
                    cancelButton: 'btn btn-secondary'
                },
                buttonsStyling: false
            }).then((result) => {
                if (result.isConfirmed) {
                    // Crear y enviar formulario POST con token anti-forgery
                    const form = document.createElement('form');
                    form.method = 'POST';
                    form.action = `/Clients/Delete?id=${id}`;

                    // Obtener el token anti-forgery (necesario en Razor Pages)
                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    const tokenInput = document.createElement('input');
                    tokenInput.type = 'hidden';
                    tokenInput.name = '__RequestVerificationToken';
                    tokenInput.value = token;
                    form.appendChild(tokenInput);

                    document.body.appendChild(form);
                    form.submit();
                }
            });
        }
    </script>
}