@page
@model AutoPartesRazor.Pages.ContactModel
@{
    ViewData["Title"] = "Contacto";
    ViewData["CartCount"] = Model.CartCount;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <!-- Header -->
            <div class="text-center mb-4">
                <i class="fa-solid fa-envelope fa-3x text-primary mb-3"></i>
                <h2 class="mb-2">Contáctanos</h2>
                <p class="text-muted">¿Tienes alguna consulta? Envíanos un mensaje y te responderemos pronto.</p>
            </div>

            <!-- Mensajes de estado -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fa-solid fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fa-solid fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Formulario de contacto -->
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Campo Asunto -->
                        <div class="form-group mb-3">
                            <label asp-for="Notification.Title" class="form-label fw-semibold">
                                <i class="fa-solid fa-tag me-1"></i>Asunto
                            </label>
                            <input asp-for="Notification.Title"
                                   class="form-control"
                                   placeholder="Ej: Consulta sobre producto"
                                   required />
                            <span asp-validation-for="Notification.Title" class="text-danger small"></span>
                        </div>

                        <!-- Campo Mensaje -->
                        <div class="form-group mb-3">
                            <label asp-for="Notification.Message" class="form-label fw-semibold">
                                <i class="fa-solid fa-comment-dots me-1"></i>Mensaje
                            </label>
                            <textarea asp-for="Notification.Message"
                                      rows="6"
                                      class="form-control"
                                      placeholder="Escribe tu mensaje aquí..."
                                      required></textarea>
                            <span asp-validation-for="Notification.Message" class="text-danger small"></span>
                        </div>

                        <!-- Información del usuario (si está autenticado) -->
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="alert alert-info mb-3">
                                <i class="fa-solid fa-info-circle me-2"></i>
                                Tu mensaje será asociado a tu cuenta: <strong>@User.Identity.Name</strong>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning mb-3">
                                <i class="fa-solid fa-exclamation-triangle me-2"></i>
                                Para enviar un mensaje, debes <a asp-page="/Account/Login" class="alert-link">iniciar sesión</a>
                            </div>
                        }

                        <!-- Botones -->
                        <div class="d-grid gap-2">
                            <button type="submit"
                                    class="btn btn-primary btn-lg"
                                    @(User.Identity?.IsAuthenticated != true ? "disabled" : "")>
                                <i class="fa-solid fa-paper-plane me-2"></i>
                                Enviar Mensaje
                            </button>
                            <a asp-page="/Index" class="btn btn-outline-secondary">
                                <i class="fa-solid fa-arrow-left me-2"></i>
                                Volver al inicio
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Información adicional -->
            <div class="row mt-4 text-center">
                <div class="col-md-6 mb-3">
                    <div class="card h-100 border-0 bg-light">
                        <div class="card-body">
                            <i class="fa-solid fa-clock fa-2x text-primary mb-2"></i>
                            <h6 class="fw-bold">Tiempo de respuesta</h6>
                            <p class="small text-muted mb-0">Respondemos en menos de 24 horas</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="card h-100 border-0 bg-light">
                        <div class="card-body">
                            <i class="fa-solid fa-headset fa-2x text-primary mb-2"></i>
                            <h6 class="fw-bold">Soporte técnico</h6>
                            <p class="small text-muted mb-0">Lunes a Viernes 9:00 - 18:00</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
