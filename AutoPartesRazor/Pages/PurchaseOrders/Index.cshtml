@page
@model AutoPartesRazor.Pages.PurchaseOrders.IndexModel

@{
    ViewData["Title"] = "Órdenes de Compra";
}

<div class="container-fluid py-4">
    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>
                <i class="fa-solid fa-clipboard-list me-2"></i>Órdenes de Compra
                @if (!string.IsNullOrEmpty(Model.SupplierName))
                {
                    <small class="text-muted">- @Model.SupplierName</small>
                }
            </h2>
            @if (Model.SelectedSupplierId.HasValue || !string.IsNullOrEmpty(Model.SelectedStatus) || !string.IsNullOrEmpty(Model.SearchTerm))
            {
                <p class="text-muted mb-0">
                    <i class="fa-solid fa-filter me-1"></i>Filtros activos
                    <a href="@Url.Page("./Index")" class="btn btn-sm btn-outline-secondary ms-2">
                        <i class="fa-solid fa-times me-1"></i>Limpiar filtros
                    </a>
                </p>
            }
        </div>
        <a asp-page="Create" class="btn btn-primary">
            <i class="fa-solid fa-plus me-1"></i>Nueva Orden
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Estadísticas -->
    <div class="row mb-4">
        <div class="col-md-2">
            <div class="card text-center">
                <div class="card-body">
                    <h4 class="mb-0">@Model.TotalOrders</h4>
                    <small class="text-muted">Total Órdenes</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-center border-warning">
                <div class="card-body">
                    <h4 class="mb-0 text-warning">@Model.PendingOrders</h4>
                    <small class="text-muted">Pendientes</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-center border-info">
                <div class="card-body">
                    <h4 class="mb-0 text-info">@Model.ApprovedOrders</h4>
                    <small class="text-muted">Aprobadas</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-center border-success">
                <div class="card-body">
                    <h4 class="mb-0 text-success">@Model.ReceivedOrders</h4>
                    <small class="text-muted">Recibidas</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-center border-danger">
                <div class="card-body">
                    <h4 class="mb-0 text-danger">@Model.CancelledOrders</h4>
                    <small class="text-muted">Canceladas</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-center bg-primary text-white">
                <div class="card-body">
                    <h5 class="mb-0">$@Model.TotalAmount.ToString("N2")</h5>
                    <small>Monto Total</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Panel de Filtros -->
    <div class="card mb-4">
        <div class="card-header bg-light">
            <h6 class="mb-0">
                <i class="fa-solid fa-filter me-2"></i>Filtros de Búsqueda
            </h6>
        </div>
        <div class="card-body">
            <form method="get" id="filterForm">
                <div class="row g-3">
                    <!-- Búsqueda por código -->
                    <div class="col-md-3">
                        <label for="searchInput" class="form-label">
                            <i class="fa-solid fa-search me-1"></i>Buscar
                        </label>
                        <input type="text"
                               name="search"
                               id="searchInput"
                               class="form-control"
                               placeholder="N° orden, producto..."
                               value="@Model.SearchTerm">
                        <small class="text-muted">Ej: 123, Filtro de aceite</small>
                    </div>

                    <!-- Filtro por proveedor -->
                    <div class="col-md-3">
                        <label for="supplierFilter" class="form-label">
                            <i class="fa-solid fa-truck me-1"></i>Proveedor
                        </label>
                        <select name="supplierId"
                                id="supplierFilter"
                                class="form-select">
                            <option value="">Todos los proveedores</option>
                            @foreach (var supplier in Model.SupplierFilterList)
                            {
                                <option value="@supplier.Value"
                                        selected="@(supplier.Value == Model.SelectedSupplierId?.ToString())">
                                    @supplier.Text
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Filtro por estado -->
                    <div class="col-md-3">
                        <label for="statusFilter" class="form-label">
                            <i class="fa-solid fa-flag me-1"></i>Estado
                        </label>
                        <select name="status"
                                id="statusFilter"
                                class="form-select">
                            <option value="">Todos los estados</option>
                            @foreach (var status in Model.StatusFilterList)
                            {
                                <option value="@status.Value"
                                        selected="@(status.Value == Model.SelectedStatus)">
                                    @status.Text
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Botones -->
                    <div class="col-md-3 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary flex-fill">
                            <i class="fa-solid fa-search me-1"></i>Buscar
                        </button>
                        <a href="@Url.Page("./Index")" class="btn btn-outline-secondary">
                            <i class="fa-solid fa-times"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla de Órdenes -->
    @if (Model.PurchaseOrders.Any())
    {
        <div class="card">
            <div class="card-header bg-white">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">
                        <i class="fa-solid fa-list me-2"></i>
                        Resultados (@Model.PurchaseOrders.Count @(Model.PurchaseOrders.Count == 1 ? "orden" : "órdenes"))
                    </h6>
                    <button class="btn btn-sm btn-outline-primary" onclick="window.print()">
                        <i class="fa-solid fa-print me-1"></i>Imprimir
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>N° Orden</th>
                                <th>Proveedor</th>
                                <th>Producto</th>
                                <th>Cantidad</th>
                                <th>Precio Unit.</th>
                                <th>Total</th>
                                <th>Estado</th>
                                <th>Fecha</th>
                                <th class="text-center" style="width: 150px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.PurchaseOrders)
                            {
                                <tr>
                                    <td class="fw-bold text-primary">#@order.Id</td>
                                    <td>
                                        <i class="fa-solid fa-truck me-1 text-muted"></i>
                                        @order.Supplier?.Name
                                    </td>
                                    <td>
                                        <i class="fa-solid fa-box me-1 text-muted"></i>
                                        @order.Product?.Name
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary">@order.Quantity un.</span>
                                    </td>
                                    <td>$@order.UnitPrice.ToString("N2")</td>
                                    <td class="fw-bold text-success">$@order.Total.ToString("N2")</td>
                                    <td>
                                        @if (order.Status != "Received")
                                        {
                                            <form method="post"
                                                  asp-page-handler="ChangeStatus"
                                                  class="d-flex gap-2 align-items-center status-form"
                                                  style="min-width: 200px;">
                                                <input type="hidden" name="orderId" value="@order.Id" />
                                                <select name="status"
                                                        class="form-select form-select-sm status-select"
                                                        asp-items="Model.StatusList"
                                                        data-current-status="@order.Status">
                                                    <option value="">-- Cambiar --</option>
                                                </select>
                                                <button type="submit"
                                                        class="btn btn-sm btn-primary"
                                                        title="Actualizar estado">
                                                    <i class="fa-solid fa-check"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="badge @GetStatusBadgeClass(order.Status)">
                                                @GetStatusText(order.Status)
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <small>@order.CreatedAt.ToString("dd/MM/yyyy")</small>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-page="./Details"
                                               asp-route-id="@order.Id"
                                               class="btn btn-sm btn-info text-white"
                                               title="Ver detalles">
                                                <i class="fa-solid fa-eye"></i>
                                            </a>
                                            @if (order.Status == "Approved")
                                            {
                                                <a asp-page="./Receive"
                                                   asp-route-id="@order.Id"
                                                   class="btn btn-sm btn-success text-white"
                                                   title="Recibir orden">
                                                    <i class="fa-solid fa-box-open"></i>
                                                </a>
                                            }
                                            @if (order.Status == "Cancelled")
                                            {
                                                <a asp-page="/Suppliers/CreateClaim"
                                                   asp-route-orderId="@order.Id"
                                                   class="btn btn-sm btn-danger text-white"
                                                   title="Hacer reclamo">
                                                    <i class="fa-solid fa-exclamation-triangle"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center py-5">
            <i class="fa-solid fa-inbox fa-3x mb-3 d-block"></i>
            <h5>No se encontraron órdenes</h5>
            <p class="text-muted">
                @if (Model.SelectedSupplierId.HasValue || !string.IsNullOrEmpty(Model.SelectedStatus) || !string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <text>No hay órdenes que coincidan con los filtros seleccionados.</text>
                }
                else
                {
                    <text>No hay órdenes de compra registradas. Crea tu primera orden para comenzar.</text>
                }
            </p>
            @if (Model.SelectedSupplierId.HasValue || !string.IsNullOrEmpty(Model.SelectedStatus) || !string.IsNullOrEmpty(Model.SearchTerm))
            {
                <a href="@Url.Page("./Index")" class="btn btn-outline-secondary mt-2">
                    <i class="fa-solid fa-times me-1"></i>Limpiar filtros
                </a>
            }
            else
            {
                <a asp-page="Create" class="btn btn-primary mt-2">
                    <i class="fa-solid fa-plus me-1"></i>Crear Primera Orden
                </a>
            }
        </div>
    }
</div>

@functions {
    string GetStatusText(string status)
    {
        return status switch
        {
            "Pending" => "Pendiente",
            "Approved" => "Aprobado",
            "Received" => "Recibido",
            "Cancelled" => "Cancelado",
            _ => status
        };
    }

    string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Pending" => "bg-warning text-dark",
            "Approved" => "bg-info",
            "Received" => "bg-success",
            "Cancelled" => "bg-danger",
            _ => "bg-secondary"
        };
    }
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Preseleccionar el estado actual en cada select
            document.querySelectorAll('.status-select').forEach(function(select) {
                const currentStatus = select.getAttribute('data-current-status');
                if (currentStatus) {
                    select.value = currentStatus;
                }
            });

            // Confirmación antes de cambiar estado
            document.querySelectorAll('.status-form').forEach(function(form) {
                form.addEventListener('submit', function(e) {
                    e.preventDefault();

                    const select = form.querySelector('select[name="status"]');
                    const newStatus = select.value;
                    const orderId = form.querySelector('input[name="orderId"]').value;

                    if (!newStatus) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Atención',
                            text: 'Debe seleccionar un estado',
                            confirmButtonText: 'Entendido'
                        });
                        return false;
                    }

                    const statusText = select.options[select.selectedIndex].text;

                    Swal.fire({
                        title: '¿Confirmar cambio de estado?',
                        html: `Orden <strong>#${orderId}</strong> cambiará a: <strong>${statusText}</strong>`,
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: 'Sí, actualizar',
                        cancelButtonText: 'Cancelar'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            form.submit();
                        }
                    });
                });
            });

            // Auto-cerrar alertas después de 5 segundos
            setTimeout(function() {
                $('.alert-dismissible').fadeOut('slow');
            }, 5000);
        });
    </script>
}

<style>
    .status-select {
        min-width: 120px;
    }

    .table td {
        vertical-align: middle;
    }

    .badge {
        font-size: 0.85rem;
        padding: 0.35em 0.65em;
    }

    .card {
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

