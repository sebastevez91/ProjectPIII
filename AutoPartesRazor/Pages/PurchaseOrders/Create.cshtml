@page
@model AutoPartesRazor.Pages.PurchaseOrders.CreateModel
@{
    ViewData["Title"] = "Nueva Orden de Pedido";
}

<div class="container py-4">
    <h2 class="mb-4">Crear Orden de Pedido</h2>

    <form method="post">
        <div class="mb-3">
            <label asp-for="purchaseOrder.ProductId" class="form-label"></label>
            <select asp-for="purchaseOrder.ProductId" class="form-select" asp-items="Model.ProductList">
                <option value="">Seleccione un producto</option>
            </select>
            <span asp-validation-for="purchaseOrder.ProductId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="purchaseOrder.SupplierId" class="form-label"></label>
            <select asp-for="purchaseOrder.SupplierId" class="form-select" asp-items="Model.SupplierList">
                <option value="">Seleccione un proveedor</option>
            </select>
            <span asp-validation-for="purchaseOrder.SupplierId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="purchaseOrder.Quantity" class="form-label"></label>
            <input asp-for="purchaseOrder.Quantity" class="form-control" />
            <span asp-validation-for="purchaseOrder.Quantity" class="text-danger"></span>
        </div>

@*         <div class="mb-3">
            <label asp-for="purchaseOrder.CreatedAt" class="form-label"></label>
            <input asp-for="purchaseOrder.CreatedAt" class="form-control" type="date" />
            <span asp-validation-for="purchaseOrder.CreatedAt" class="text-danger"></span>
        </div> *@

        <button type="submit" class="btn btn-primary">Crear Orden</button>
        <a asp-page="Index" class="btn btn-secondary">Volver</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
