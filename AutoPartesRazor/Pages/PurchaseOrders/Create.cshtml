@page
@model AutoPartesRazor.Pages.PurchaseOrders.CreateModel

@{
    ViewData["Title"] = "Nueva Orden de Compra";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fa-solid fa-cart-plus me-2"></i>Nueva Orden de Compra
                    </h4>
                </div>
                <div class="card-body">
                    <form method="post" id="purchaseOrderForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Proveedor (Ahora va primero) -->
                        <div class="mb-3">
                            <label asp-for="PurchaseOrder.SupplierId" class="form-label fw-bold">
                                <i class="fa-solid fa-truck me-1"></i>Proveedor
                            </label>
                            <select asp-for="PurchaseOrder.SupplierId"
                                    class="form-select"
                                    asp-items="Model.SupplierList"
                                    id="supplierSelect">
                                <option value="">-- Seleccione un proveedor --</option>
                            </select>
                            <span asp-validation-for="PurchaseOrder.SupplierId" class="text-danger"></span>
                            <small class="text-muted d-block mt-1">
                                <i class="fa-solid fa-info-circle me-1"></i>
                                Primero seleccione el proveedor
                            </small>
                        </div>

                        <!-- Producto -->
                        <div class="mb-3">
                            <label asp-for="PurchaseOrder.ProductId" class="form-label fw-bold">
                                <i class="fa-solid fa-box me-1"></i>Producto
                            </label>
                            <select asp-for="PurchaseOrder.ProductId"
                                    class="form-select"
                                    asp-items="Model.ProductList"
                                    id="productSelect"
                                    disabled>
                                <option value="">-- Primero seleccione un proveedor --</option>
                            </select>
                            <span asp-validation-for="PurchaseOrder.ProductId" class="text-danger"></span>
                            <small class="text-muted d-block mt-1" id="productInfo">
                                <i class="fa-solid fa-info-circle me-1"></i>
                                Solo se mostrarán productos asignados al proveedor
                            </small>
                        </div>

                        <!-- Alerta de sin productos -->
                        <div id="noProductsAlert" class="alert alert-warning" style="display: none;">
                            <i class="fa-solid fa-exclamation-triangle me-2"></i>
                            <strong>Este proveedor no tiene productos asignados.</strong>
                            <br>
                            <small>
                                Por favor,
                                <a href="#" id="assignProductsLink" class="alert-link" target="_blank">
                                    asigne productos al proveedor
                                </a>
                                antes de crear una orden.
                            </small>
                        </div>

                        <!-- Cantidad -->
                        <div class="mb-3">
                            <label asp-for="PurchaseOrder.Quantity" class="form-label fw-bold">
                                <i class="fa-solid fa-calculator me-1"></i>Cantidad
                            </label>
                            <input asp-for="PurchaseOrder.Quantity"
                                   type="number"
                                   class="form-control"
                                   id="quantityInput"
                                   min="1"
                                   placeholder="Ingrese la cantidad"
                                   value="1" />
                            <span asp-validation-for="PurchaseOrder.Quantity" class="text-danger"></span>
                        </div>

                        <!-- Información calculada -->
                        <div class="card bg-light mb-3" id="calculationCard" style="display: none;">
                            <div class="card-body">
                                <h6 class="card-title">
                                    <i class="fa-solid fa-info-circle me-2"></i>Resumen de la Orden
                                </h6>
                                <div class="row">
                                    <div class="col-md-6">
                                        <p class="mb-1">
                                            <strong>Precio Unitario:</strong>
                                            <span id="unitPriceDisplay" class="text-primary">$0.00</span>
                                        </p>
                                    </div>
                                    <div class="col-md-6">
                                        <p class="mb-1">
                                            <strong>Total:</strong>
                                            <span id="totalDisplay" class="text-success fs-5">$0.00</span>
                                        </p>
                                    </div>
                                </div>
                                <small class="text-muted">
                                    <i class="fa-solid fa-circle-info me-1"></i>
                                    Los cálculos se actualizan automáticamente
                                </small>
                            </div>
                        </div>

                        <!-- Botones -->
                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-page="./Index" class="btn btn-secondary">
                                <i class="fa-solid fa-arrow-left me-1"></i>Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary" id="submitBtn">
                                <i class="fa-solid fa-check me-1"></i>Crear Orden
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Información adicional -->
            <div class="alert alert-info mt-3">
                <i class="fa-solid fa-lightbulb me-2"></i>
                <strong>Nota:</strong> Solo podrá crear órdenes con productos que el proveedor tenga asignados.
                El precio se calculará según el precio de suministro configurado.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function() {
            let unitPrice = 0;
            let allProducts = []; // Guardar todos los productos del proveedor

            // Verificar si hay un precio inicial (cuando se carga con datos pre-cargados)
            @if (ViewData["InitialPrice"] != null)
            {
                    <text>
                    unitPrice = @ViewData["InitialPrice"];
                    calculateTotal();
                    </text>
            }

            // Función para calcular y mostrar el total
            function calculateTotal() {
                const quantity = parseInt($('#quantityInput').val()) || 0;
                const total = unitPrice * quantity;

                $('#unitPriceDisplay').text('$' + unitPrice.toFixed(2));
                $('#totalDisplay').text('$' + total.toFixed(2));

                if (unitPrice > 0 && quantity > 0) {
                    $('#calculationCard').slideDown();
                } else {
                    $('#calculationCard').slideUp();
                }
            }

            // ✅ NUEVO: Cargar productos cuando se selecciona un proveedor
            $('#supplierSelect').on('change', async function() {
                const supplierId = $(this).val();
                const productSelect = $('#productSelect');
                const noProductsAlert = $('#noProductsAlert');
                const assignProductsLink = $('#assignProductsLink');

                // Resetear
                productSelect.html('<option value="">-- Seleccione un producto --</option>');
                productSelect.prop('disabled', true);
                unitPrice = 0;
                calculateTotal();
                noProductsAlert.hide();

                if (!supplierId) {
                    productSelect.html('<option value="">-- Primero seleccione un proveedor --</option>');
                    return;
                }

                try {
                    const response = await fetch(`?handler=SupplierProducts&supplierId=${supplierId}`);
                    const data = await response.json();

                    if (data.success && data.products.length > 0) {
                        allProducts = data.products;

                        data.products.forEach(product => {
                            const option = new Option(
                                `${product.name} (Stock: ${product.stock})`,
                                product.id
                            );
                            $(option).data('price', product.price);
                            productSelect.append(option);
                        });

                        productSelect.prop('disabled', false);
                        $('#productInfo').html(
                            '<i class="fa-solid fa-check-circle me-1 text-success"></i>' +
                            `${data.products.length} producto(s) disponible(s) de este proveedor`
                        );
                    } else {
                        productSelect.html('<option value="">-- Este proveedor no tiene productos --</option>');
                        assignProductsLink.attr('href', `/Suppliers/AssignProducts/${supplierId}`);
                        noProductsAlert.show();
                        $('#productInfo').html(
                            '<i class="fa-solid fa-exclamation-triangle me-1 text-warning"></i>' +
                            'Este proveedor no tiene productos asignados'
                        );
                    }
                } catch (error) {
                    console.error('Error al cargar productos:', error);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'No se pudieron cargar los productos del proveedor'
                    });
                }
            });

            // Cuando se selecciona un producto, cargar su precio
            $('#productSelect').on('change', function() {
                const selectedOption = $(this).find(':selected');
                const price = selectedOption.data('price');

                if (price) {
                    unitPrice = parseFloat(price);
                    calculateTotal();
                } else {
                    unitPrice = 0;
                    calculateTotal();
                }
            });

            // Eventos para recalcular
            $('#quantityInput').on('input', calculateTotal);

            // Validación del formulario
            $('#purchaseOrderForm').on('submit', function(e) {
                const productId = $('#productSelect').val();
                const supplierId = $('#supplierSelect').val();
                const quantity = parseInt($('#quantityInput').val()) || 0;

                let errors = [];

                if (!supplierId) {
                    errors.push('Debe seleccionar un proveedor');
                }
                if (!productId) {
                    errors.push('Debe seleccionar un producto');
                }
                if (quantity <= 0) {
                    errors.push('La cantidad debe ser mayor a 0');
                }

                if (errors.length > 0) {
                    e.preventDefault();
                    Swal.fire({
                        icon: 'error',
                        title: 'Formulario incompleto',
                        html: '<ul class="text-start">' +
                              errors.map(err => '<li>' + err + '</li>').join('') +
                              '</ul>',
                        confirmButtonText: 'Entendido'
                    });
                    return false;
                }

                // Confirmación antes de crear
                e.preventDefault();

                const productName = $('#productSelect option:selected').text();
                const supplierName = $('#supplierSelect option:selected').text();

                Swal.fire({
                    title: '¿Crear orden de compra?',
                    html: `
                        <div class="text-start">
                            <p><strong>Proveedor:</strong> ${supplierName}</p>
                            <p><strong>Producto:</strong> ${productName}</p>
                            <p><strong>Cantidad:</strong> ${quantity} unidades</p>
                            <p><strong>Precio unitario:</strong> $${unitPrice.toFixed(2)}</p>
                            <p><strong>Total:</strong> <span class="text-success fs-5">$${(unitPrice * quantity).toFixed(2)}</span></p>
                        </div>
                    `,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#0d6efd',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: '<i class="fa-solid fa-check me-1"></i>Sí, crear orden',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $('#submitBtn').prop('disabled', true);
                        $('#submitBtn').html('<span class="spinner-border spinner-border-sm me-1"></span>Creando...');
                        this.submit();
                    }
                });
            });

            // Si hay un proveedor pre-seleccionado, cargar sus productos
            const preSelectedSupplier = $('#supplierSelect').val();
            if (preSelectedSupplier) {
                $('#supplierSelect').trigger('change');
            }
        });
    </script>

    <style>
        .card {
            border: none;
            border-radius: 10px;
        }

        .card-header {
            border-radius: 10px 10px 0 0 !important;
            padding: 1.25rem;
        }

        #calculationCard {
            border: 2px solid #0d6efd;
            transition: all 0.3s ease;
        }

        .form-label {
            color: #495057;
        }

        .form-select:focus,
        .form-control:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }

        select:disabled {
            background-color: #e9ecef;
            cursor: not-allowed;
        }
    </style>
}