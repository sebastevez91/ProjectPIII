    <script>
        $(document).ready(function() {
            let unitPrice = 0;

            // Función para calcular y mostrar el total
            function calculateTotal() {
                const quantity = parseInt($('#quantityInput').val()) || 0;
                const total = unitPrice * quantity;

                $('#unitPriceDisplay').text('$' + unitPrice.toFixed(2));
                $('#totalDisplay').text('$' + total.toFixed(2));

                if (unitPrice > 0 && quantity > 0) {
                    $('#calculationCard').slideDown();
                } else {
                    $('#calculationCard').slideUp();
                }
            }

            // Función para obtener el precio del proveedor
            async function loadSupplierPrice() {
                const productId = $('#productSelect').val();
                const supplierId = $('#supplierSelect').val();

                if (!productId || !supplierId) {
                    unitPrice = 0;
                    calculateTotal();
                    return;
                }

                try {
                    const response = await fetch(
                        `?handler=SupplierPrice&productId=${productId}&supplierId=${supplierId}`
                    );
                    const data = await response.json();

                    if (data.success) {
                        unitPrice = data.price;
                        calculateTotal();
                    }
                } catch (error) {
                    console.error('Error al obtener precio:', error);
                }
            }

            // Eventos para recalcular
            $('#productSelect, #supplierSelect').on('change', loadSupplierPrice);
            $('#quantityInput').on('input', calculateTotal);

            // Validación del formulario
            $('#purchaseOrderForm').on('submit', function(e) {
                const productId = $('#productSelect').val();
                const supplierId = $('#supplierSelect').val();
                const quantity = parseInt($('#quantityInput').val()) || 0;

                let errors = [];

                if (!productId) {
                    errors.push('Debe seleccionar un producto');
                }
                if (!supplierId) {
                    errors.push('Debe seleccionar un proveedor');
                }
                if (quantity <= 0) {
                    errors.push('La cantidad debe ser mayor a 0');
                }

                if (errors.length > 0) {
                    e.preventDefault();
                    Swal.fire({
                        icon: 'error',
                        title: 'Formulario incompleto',
                        html: '<ul class="text-start">' +
                              errors.map(err => '<li>' + err + '</li>').join('') +
                              '</ul>',
                        confirmButtonText: 'Entendido'
                    });
                    return false;
                }

                // Confirmación antes de crear
                e.preventDefault();
                Swal.fire({
                    title: '¿Crear orden de compra?',
                    html: `
                        <div class="text-start">
                            <p><strong>Cantidad:</strong> ${quantity} unidades</p>
                            <p><strong>Precio unitario:</strong> $${unitPrice.toFixed(2)}</p>
                            <p><strong>Total:</strong> <span class="text-success fs-5">$${(unitPrice * quantity).toFixed(2)}</span></p>
                        </div>
                    `,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#0d6efd',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: '<i class="fa-solid fa-check me-1"></i>Sí, crear orden',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $('#submitBtn').prop('disabled', true);
                        $('#submitBtn').html('<span class="spinner-border spinner-border-sm me-1"></span>Creando...');
                        this.submit();
                    }
                });
            });
        });
    </script>

