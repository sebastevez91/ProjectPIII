@page
@model AutoPartesRazor.Pages.PurchaseOrders.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Detalles de la orden de pedido</h1>

<div>
    <h4>Orden N° #@Model.PurchaseOrder.Id</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PurchaseOrder.Product.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PurchaseOrder.Product.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PurchaseOrder.Supplier)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PurchaseOrder.Supplier.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PurchaseOrder.Quantity)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PurchaseOrder.Quantity)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PurchaseOrder.Status)
        </dt>
        <dd class="col-sm-10">
            <small class="d-block mt-1">
                <span class="badge @GetStatusBadgeClass(Model.PurchaseOrder.Status)">
                    @GetStatusText(Model.PurchaseOrder.Status)
                </span>
            </small>
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PurchaseOrder.CreatedAt)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PurchaseOrder.CreatedAt)
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Index" class="btn btn-primary btn-sm">Volver</a>
</div>

@functions {
    private string GetStatusText(string status)
    {
        return status switch
        {
            "Pending" => "PENDIENTE",
            "Approved" => "APROBADA",
            "Received" => "RECIBIDA",
            "Cancelled" => "CANCELADA",
            _ => status.ToString()
        };
    }

    string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Pending" => "bg-warning text-dark",
            "Approved" => "bg-info",
            "Received" => "bg-success",
            "Cancelled" => "bg-danger",
            _ => "bg-secondary"
        };
    }
}
