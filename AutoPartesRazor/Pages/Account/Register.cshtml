@page
@model AutoPartesRazor.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Registro";
}

<div class="container w-50">
    <h2>Registro</h2>
    <div>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="ViewModels.Name">Usuario</label>
                <input asp-for="ViewModels.Name" class="form-control" placeholder="Ingrese su nombre de usuario" />

                <span asp-validation-for="ViewModels.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ViewModels.Email">Email</label>
                <input asp-for="ViewModels.Email" class="form-control" placeholder="Ingrese su email" />

                <span asp-validation-for="ViewModels.Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ViewModels.Password">Contraseña</label>
                <input asp-for="ViewModels.Password" class="form-control" type="password" placeholder="Ingrese su contraseña" />

                <span asp-validation-for="ViewModels.Password" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ViewModels.ConfirmPassword">Reingresa la contraseña</label>
                <input asp-for="ViewModels.ConfirmPassword" class="form-control" type="password" placeholder="Vuelva a ingresar su contraseña" />

                <span asp-validation-for="ViewModels.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary text-center m-2">Crear</button>
        </form>
    </div>
</div>