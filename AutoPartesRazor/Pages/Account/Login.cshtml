@page
@model AutoPartesRazor.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
}

<style>
    .login-left {
        background: linear-gradient(135deg, #667eea 0%, #0049b5 100%);
        min-height: 100vh;
    }

    .login-logo {
        filter: brightness(0) invert(1);
    }
</style>

<div class="container-fluid">
    <div class="row min-vh-100">
        <!-- Lado izquierdo - Branding -->
        <div class="col-lg-6 login-left d-none d-lg-flex align-items-center justify-content-center text-white">
            <div class="text-center p-5">
                <img src="~/img/logo.png" class="img-fluid login-logo mb-4"
                     alt="Logo" style="max-width: 250px;">
                <p class="lead">Conseguí los repuestos y accesorios que necesiten tu auto
                    en un solo lugar 
                </p>
            </div>
        </div>

        <!-- Lado derecho - Formulario -->
        <div class="col-lg-6 d-flex align-items-center justify-content-center bg-light">
            <div class="w-100 px-4" style="max-width: 380px;">
                @if (TempData["Message"] != null)
                {
                    <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
                        @TempData["Message"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <div class="mb-4">
                    <h2 class="fw-bold mb-2">Iniciar Sesión</h2>
                    <p class="text-muted">Ingresa tus credenciales para continuar</p>
                </div>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="LoginInput.Email" class="form-label fw-semibold">Email</label>
                        <input asp-for="LoginInput.Email" class="form-control"
                               placeholder="tu@email.com" />
                        <span asp-validation-for="LoginInput.Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="LoginInput.Password" class="form-label fw-semibold">Contraseña</label>
                        <input asp-for="LoginInput.Password" class="form-control"
                               type="password" placeholder="••••••••" />
                        <span asp-validation-for="LoginInput.Password" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="LoginInput.RememberMe" class="form-check-input" />
                            <label asp-for="LoginInput.RememberMe" class="form-check-label small">
                                Recuérdame
                            </label>
                        </div>
                        <a asp-page="/Account/ForgotPassword" class="text-decoration-none small">
                            ¿Olvidaste tu contraseña?
                        </a>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mb-4">
                        Ingresar
                    </button>

                    <p class="text-center text-muted small">
                        ¿No tienes cuenta?
                        <a asp-page="Register" class="text-decoration-none fw-semibold text-primary">
                            Regístrate gratis
                        </a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}