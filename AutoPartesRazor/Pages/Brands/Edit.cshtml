@page
@model AutoPartesRazor.Pages.Brands.EditModel

@{
    ViewData["Title"] = "Editar Marca";
}

<h1>Editar Marca</h1>

<div class="container mt-4">
      <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card bg-dark text-white mb-3 shadow-sm border-0">
                <div class="card-body p-4">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <input type="hidden" asp-for="Brand.id" />

                        <div class="mb-4">
                            <label asp-for="Brand.name" class="form-label fw-semibold">
                                Nombre de la Marca
                            </label>
                            <div class="input-group">
                                <input asp-for="Brand.name" class="form-control border-start-0" placeholder="Ej: Toyota, Ford, etc." />
                            </div>
                            <span asp-validation-for="Brand.name" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-between mt-4 pt-3 border-top">
                            <a asp-page="./Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-success"> Guardar Cambios </button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="alert alert-info border-0 mt-3" role="alert">
                <div class="d-flex">
                  <small>Los cambios se aplicarán inmediatamente después de guardar.</small>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
