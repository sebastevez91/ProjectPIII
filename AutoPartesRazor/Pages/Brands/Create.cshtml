@page
@model AutoPartesRazor.Pages.Brands.CreateModel

@{
    ViewData["Title"] = "Crear";
}

<h1>Crear</h1>
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card bg-dark text-white mb-3 shadow-sm border-0">
                <div class="card-body p-4">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="mb-4">
                            <label asp-for="Brand.name" class="control-label fs-4 fw-bold"></label>
                            <input asp-for="Brand.name" class="form-control" />
                            <span asp-validation-for="Brand.name" class="text-danger"></span>
                        </div>
                        <div class="d-grid gap-2 d-md-flex justify-content-md-between mt-4 pt-3 border-top">
                            <a asp-page="Index" class="btn btn-outline-secondary">Volver</a>
                            <input type="submit" value="Crear" class="btn btn-success" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
