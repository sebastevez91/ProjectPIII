@page
@model AutoPartesRazor.Pages.Brands.IndexModel

@{
    ViewData["Title"] = "Lista de Marcas";
}

<h1>Lista de Marcas</h1>

<p>
    <a asp-page="Create" class="btn btn-light">Crear Nueva Marca</a>
</p>
<table class="table table-hover shadow-sm table-primary table-striped fs-5 w-50">
    <thead class="table-dark">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Brand[0].name)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Brand) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.name)
            </td>
            <td class="text-end">
                    <a asp-page="./Edit" asp-route-id="@item.id" class="btn btn-sm btn-success me-1">Editar</a> |
                    <a asp-page="./Details" asp-route-id="@item.id" class="btn btn-sm btn-secondary me-1">Detalles</a> |
                    <a asp-page="./Delete" asp-route-id="@item.id" class="btn btn-sm btn-danger">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
<div>
    <a asp-page="/Index" class="btn btn-secondary">Volver</a>
</div>
