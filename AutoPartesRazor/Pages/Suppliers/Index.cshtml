@page
@model AutoPartesRazor.Pages.Suppliers.IndexModel
@{
    ViewData["Title"] = "Proveedores";
}

<div class="container py-4">
    <h2 class="mb-3">Proveedores</h2>

    <a asp-page="Create" class="btn btn-primary mb-3">Nuevo Proveedor</a>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Email</th>
                <th>Teléfono</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model.Suppliers)
            {
                <tr>
                    <td>@s.Name</td>
                    <td>@s.Email</td>
                    <td>@s.Phone</td>
                    <td>
                        <!-- Botón de editar (si ya lo tienes) -->
                        <a asp-page="./Edit"
                           asp-route-id="@s.Id"
                           class="btn btn-sm btn-warning text-white"
                           title="Editar">
                            <i class="fa-solid fa-pen"></i>
                        </a>
                        <a asp-page="Delete" asp-route-id="@s.Id" class="btn btn-danger btn-sm" title="Eliminar"><i class="fa-solid fa-trash"></i></a>
                        <!-- Botón para gestionar productos del proveedor -->
                        <a asp-page="./Products"
                           asp-route-id="@s.Id"
                           class="btn btn-sm btn-info text-white"
                           title="Gestionar productos">
                            <i class="fa-solid fa-boxes-stacked"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
