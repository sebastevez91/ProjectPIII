@page
@model AutoPartesRazor.Pages.Suppliers.CreateModel

<div class="container py-4">
    <h2>Nuevo Proveedor</h2>

    <form method="post">
        <div class="mb-3">
            <label asp-for="Supplier.Name"></label>
            <input asp-for="Supplier.Name" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Supplier.Email"></label>
            <input asp-for="Supplier.Email" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Supplier.Phone"></label>
            <input asp-for="Supplier.Phone" class="form-control" />
        </div>

        <button class="btn btn-success">Guardar</button>
        <a asp-page="Index" class="btn btn-secondary">Volver</a>
    </form>
</div>
