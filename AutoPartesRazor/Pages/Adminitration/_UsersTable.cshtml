@model IEnumerable<AutoPartesRazor.Models.User>

@if (Model != null && Model.Any())
{
    <table class="table table-dark table-bordered">
        <thead>
            <tr>
                <th>Nombre de usuario</th>
                <th>Email</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var user in Model)
            {
                <tr>
                    <td>@user.Name</td>
                    <td>@user.Email</td>
                    <td>
                        <a asp-page="/Users/Edit" asp-route-id="@user.Id" class="btn btn-primary btn-sm me-2">
                            <i class="fa-regular fa-pen-to-square"></i>
                        </a>
                        <a asp-page="/Users/Details" asp-route-id="@user.Id" class="btn btn-secondary btn-sm me-2">
                            <i class="fa-brands fa-phabricator"></i>
                        </a>
                        <button type="button" class="btn btn-danger btn-sm me-2"
                                onclick="confirmDelete('@user.Id', 'Users', 'usuario', '@user.UserName')">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning">No se encontraron usuarios.</div>
}
