@page
@model AutoPartesRazor.Pages.Adminitration.AdminDashboardModel
@{
    ViewData["Title"] = "Panel de Administración";
}

<div class="container py-4">
    <h2 class="mb-4">Panel de Administración</h2>

    <div class="mb-3">
        <button class="btn btn-primary ms-2 text-white btn-lg" onclick="toggleSection('notificationSection')">
            <i class="fa-solid fa-envelope"></i>  Ver Notificaciones
        </button>
        <button class="btn btn-primary ms-2 text-white btn-lg" onclick="toggleSection('orderSection')">
            <i class="fa-solid fa-book"></i>  Ver Órdenes
        </button>
        <button class="btn btn-primary ms-2 text-white btn-lg" onclick="toggleSection('usersSection')">
            <i class="fa-solid fa-users"></i>  Gestionar Usuarios
        </button>
        <button class="btn btn-primary ms-2 text-white btn-lg" onclick="toggleSection('productsSection')">
            <i class="fa-solid fa-list-check"></i>  Gestionar Productos
        </button>
    </div>

    <!-- Sección de Productos -->
    <div id="productsSection" class="mt-4" style="display:none;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">Listado de Productos</h3>
            <div>
                <a asp-page="/Products/Create" class="btn btn-primary">Nuevo producto</a>
                <button class="btn btn-primary ms-2" onclick="toggleSection('categoriesSection')">Categorías</button>
                <button class="btn btn-primary ms-2" onclick="toggleSection('brandSection')">Marcas</button>
            </div>
        </div>
        <partial name="_ProductsTable" model="Model.Products" />

        <!-- Sección de Categorías -->
        <div id="categoriesSection" style="display:none;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="mb-0">Listado de Categorías</h3>
                <a asp-page="/Categories/Create" class=" btn btn-primary">Nueva categoría</a>
            </div>
            <partial name="_CategoriesTable" model="Model.Categories" />
        </div>

        <!-- Sección de Marcas -->
        <div id="brandSection" style="display:none;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="mb-0">Listado de Marcas</h3>
                <a asp-page="/Brands/Create" class=" btn btn-primary m-2">Nueva marca</a>
            </div>
            <partial name="_BrandTable" model="Model.Brands" />
        </div>
    </div>

    <!-- Sección de Usuarios -->
    <div id="usersSection" class="mt-4" style="display:none;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">Listado de Usuarios</h3>
            <a asp-page="/Users/Create" class="btn btn-primary">Nuevo usuario</a>
        </div>
        <partial name="_UsersTable" model="Model.Users" />
    </div>

    <!-- Sección de Órdenes -->
    <div id="orderSection" class="mt-4" style="display:none;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">Listado de Órdenes</h3>
        </div>
        <partial name="_OrdenesTable" model="Model.Orders" />
    </div>  

    <!-- Sección de Notificaciones -->
    <div id="notificationSection" class="mt-4" style="display:none;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">Listado de Notificaciones</h3>
        </div>
        <partial name="_NotificationTable" model="Model.Notifications" />
    </div>
</div>

@section Scripts {
    <script>
        function toggleSection(id) {
            const el = document.getElementById(id);
            el.style.display = el.style.display === 'none' ? 'block' : 'none';
        }
    </script>
}