@model IEnumerable<AutoPartesRazor.Models.Order>

@if(Model != null && Model.Any())
{
    <table class="table table-hover shadow-sm table-primary table-striped fs-6">
        <thead class="table-dark">
            <tr>
                <th>Número de Orden</th>
                <th>Fecha de Creación</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var order in Model)
            {
                <tr>
                    <td>#@order.id</td>
                    <td>@order.CreatedAt.ToString("dd/MM/yyyy")</td>
                    <td>@order.Status</td>
                    <td>
                        <a asp-page="/Orders/Details" asp-route-id="@order.id" class="btn btn-secondary btn-sm me-2" title="Ver detalles">
                            <i class="fa-brands fa-phabricator"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning">No se encontraron órdenes.</div>
}
