@page "{id:int}"
@model AutoPartesRazor.Pages.Orders.TrackOrderModel

<h2 class="fw-bold text-success animate__animated animate__fadeInLeft">
<<<<<<< HEAD
    <i class="fa-solid fa-location-arrow"></i> Seguimiento del Pedido [#@Model.Pedido.Id]
=======
    <i class="fa-solid fa-location-arrow"></i> Seguimiento del Pedido [#@Model.Pedido.Id](mailto:#@Model.Pedido.Id)
>>>>>>> main
</h2>

@* Stepper visual *@
@{
    var steps = new List<(string Estado, string Icon, string ColorClass)>
    {
        ("Pending", "fa-file-lines", "bg-secondary"),
        ("Preparando", "fa-box-open", "bg-info"),
        ("Despachado", "fa-truck-loading", "bg-warning"),
        ("En camino", "fa-truck", "bg-primary"),
        ("Entregado", "fa-check-circle", "bg-success")
    };
    int currentStep = steps.FindIndex(s => s.Estado == Model.Pedido.Status);
    if (currentStep == -1) { currentStep = 0; }
}
<div class="stepper my-4 p-2 animate__animated animate__fadeIn">
    <div class="d-flex justify-content-between align-items-center flex-wrap">
        @for (int i = 0; i < steps.Count; i++)
        {
            var (estado, icono, colorClase) = steps[i];
            var alcanzado = i <= currentStep;
            <div class="text-center flex-fill">
                <div class="step-circle @colorClase @(alcanzado ? "step-active animate__animated animate__bounce" : "inactive")">
                    <i class="fa-solid @(icono)"></i>
                </div>
                <div class="step-label mt-2 fw-semibold" style="font-size:1em; color:@(alcanzado ? "#18202E" : "#bbb");">
                    @estado
                </div>
            </div>
            @if (i < steps.Count - 1)
            {
                <div class="flex-grow-1 px-1 step-line @(i < currentStep ? "step-line-active" : "")"></div>
            }
        }
    </div>
</div>

@* Código QR y API REST (NUEVA FUNCIÓN) *@

<div class="card shadow mt-5 border-0 bg-light">
    <div class="card-body text-center">
        <h4 class="card-title text-primary"><i class="fa-solid fa-qrcode me-2"></i> Seguimiento con Código QR</h4>
        <p class="card-text text-muted">Escanea este código o usa el enlace para ver el estado actual del pedido a través de nuestra API REST.</p>

        <div class="mb-3">
            <span class="badge bg-dark fs-5 p-3">ID: @Model.Pedido.Id</span>
        </div>

        <div id="qrcode" class="d-inline-block p-2 border rounded bg-white"></div>

        <p class="small mt-2 text-muted">El código apunta a: <span class="fw-bold">/api/track/@Model.Pedido.Id</span></p>

        <a href="/api/track/@Model.Pedido.Id" target="_blank" class="btn btn-outline-primary btn-sm">
            <i class="fa-solid fa-magnifying-glass me-1"></i> Consultar Estado vía API REST
        </a>
    </div>
</div>

<a asp-page="/Orders/MyOrders" class="btn btn-secondary btn-lg shadow-sm animate__animated animate__fadeInUp mt-4">
    <i class="fa-solid fa-arrow-left"></i> Volver a mis pedidos
</a>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // 💡 CORRECCIÓN CRÍTICA: Reemplaza window.location.origin con tu IP y HTTP.
            // REEMPLAZA [TU_IP_LOCAL] con la dirección IPv4 que copiaste (Ej: 'http://192.168.1.105:7204')
            const apiBaseUrl = 'http://192.168.0.162:7204';

            const trackingId = @Model.Pedido.Id;
            const apiPath = `${apiBaseUrl}/api/track/${trackingId}`;

            if (document.getElementById("qrcode")) {
                new QRCode(document.getElementById("qrcode"), {
                    text: apiPath,
                    width: 128,
                    height: 128,
                    colorDark: "#000000",
                    colorLight: "#ffffff",
                    correctLevel: QRCode.CorrectLevel.H
                });
            }
        });
    </script>
}

@functions {
    public string GetProgress()
    {
        if (Model.Pedido.Status == "Pending") return "10%";
        if (Model.Pedido.Status == "Preparando") return "30%";
        if (Model.Pedido.Status == "Despachado") return "60%";
        if (Model.Pedido.Status == "En camino") return "85%";
        if (Model.Pedido.Status == "Entregado") return "100%";
        if (Model.Pedido.Status == "Cancelado") return "100%";
        return "0%";
    }
    public string GetProgressColor()
    {
        if (Model.Pedido.Status == "Pending") return "bg-warning text-dark";
        if (Model.Pedido.Status == "Preparando") return "bg-info text-dark";
        if (Model.Pedido.Status == "Despachado") return "bg-primary";
        if (Model.Pedido.Status == "En camino") return "bg-primary";
        if (Model.Pedido.Status == "Entregado") return "bg-success";
        if (Model.Pedido.Status == "Cancelado") return "bg-danger";
        return "bg-info";
    }
}