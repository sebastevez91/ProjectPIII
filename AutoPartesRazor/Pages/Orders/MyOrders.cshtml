@page
@model AutoPartesRazor.Pages.Orders.MyOrdersModel

<h2 class="mt-4 mb-4 fw-bold text-primary">
    <i class="fa-solid fa-box"></i> Mis pedidos
</h2>

<table class="table table-hover table-striped shadow-lg rounded">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Fecha</th>
            <th>Total</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @* CORRECCIÓN CS1061: Iteramos sobre la propiedad 'Pedidos' *@
        @foreach (var p in Model.Pedidos)
        {
            <tr class="align-middle">
                <td>@p.Id</td>
                <td>@p.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                <td>$@p.Total.ToString("N2")</td>

                <td>
                    @{
                        // Lógica para determinar el estilo del badge
                        string status = p.Status ?? "Pendiente";
                        string badgeClass = "bg-secondary";
                        string anim = "animate__pulse";
                        string badgeIcon = "<i class='fa-solid fa-truck-ramp-box'></i>";

                        if (status == "Pending" || status == "Pendiente")
                        {
                            badgeClass = "bg-warning text-dark";
                            badgeIcon = "<i class='fa-solid fa-clock'></i>";
                            anim = "animate__pulse";
                        }
                        else if (status == "Preparando")
                        {
                            badgeClass = "bg-info text-dark";
                            badgeIcon = "<i class='fa-solid fa-box-open'></i>";
                            anim = "animate__flash";
                        }
                        else if (status == "En Camino")
                        {
                            badgeClass = "bg-primary";
                            badgeIcon = "<i class='fa-solid fa-route'></i>";
                            anim = "animate__bounceIn";
                        }
                        else if (status == "Entregado")
                        {
                            badgeClass = "bg-success";
                            badgeIcon = "<i class='fa-solid fa-check-double'></i>";
                            anim = "animate__tada";
                        }
                        else if (status == "Cancelado")
                        {
                            badgeClass = "bg-danger";
                            badgeIcon = "<i class='fa-solid fa-xmark'></i>";
                        }
                    }
                    <span class="badge @badgeClass px-3 py-2 animate__animated @anim" style="font-size:1em;">
                        @Html.Raw(badgeIcon) @status
                    </span>
                </td>

                <td>
                    @* Enlace para ver el seguimiento detallado (TrackOrder) *@
                    <a asp-page="/Orders/TrackOrder" asp-route-id="@p.Id" class="btn btn-info btn-sm">
                        <i class="fa-solid fa-magnifying-glass"></i> Ver Seguimiento
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>