@page
@model MyOrdersModel

<h2 class="mt-4 mb-4 fw-bold text-primary">
    <i class="fa-solid fa-box"></i> Mis pedidos
</h2>

<table class="table table-hover table-striped shadow rounded">
    <thead class="table-dark">
        <tr class="animate__animated animate__fadeInDown">
            <th>ID</th>
            <th>Fecha</th>
            <th>Estado</th>
            <th>Acción</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model.Pedidos)
        {
            string badgeClass = "bg-secondary";
            string anim = p.Status == "Pending" ? "animate__pulse" : "animate__jello";
            string badgeIcon = "<i class='fa-solid fa-clock'></i>";
            if (p.Status == "Pending") { badgeClass = "bg-warning text-dark"; badgeIcon = "<i class='fa-solid fa-clock'></i>"; }
            else if (p.Status == "Despachado") { badgeClass = "bg-success"; badgeIcon = "<i class='fa-solid fa-truck'></i>"; }
            else if (p.Status == "Cancelado") { badgeClass = "bg-danger"; badgeIcon = "<i class='fa-solid fa-xmark'></i>"; }
            <tr class="align-middle animate__animated animate__fadeInUp">
                <td>@p.Id</td>
                <td>@p.CreatedAt.ToShortDateString()</td>
                <td>
                    <span class="badge @badgeClass px-3 py-2 animate__animated @anim" style="font-size:1em;">
                        @Html.Raw(badgeIcon) @p.Status
                    </span>
                </td>
                <td>
                    <a asp-page="/Orders/TrackOrder" asp-route-id="@p.Id"
                       class="btn btn-info btn-sm shadow-sm animate__animated animate__fadeIn">
                        <i class="fa-solid fa-location-arrow"></i> Ver Tracking
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
