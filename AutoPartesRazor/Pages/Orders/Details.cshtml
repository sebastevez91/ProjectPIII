@page "{id:int}"
@model AutoPartesRazor.Pages.Orders.DetailsModel

@{
    ViewData["Title"] = "Detalles del pedido";
}

<div class="container py-4">
    @if (Model.Order == null)
    {
        <div class="alert alert-danger">Pedido no encontrado.</div>
    }
    else
    {
        <h2>Pedido #@Model.Order.id</h2>
        <div class="mb-3">
            <small class="text-muted">Fecha: @Model.Order.CreatedAt.ToLocalTime().ToString("g")</small>
        </div>

        <div class="row mb-4">
            <div class="col-md-6">
                <h5>Datos del cliente</h5>
                <p class="mb-1"><strong>Nombre:</strong> @Model.Order.CustomerName</p>
                <p class="mb-1"><strong>Email:</strong> @Model.Order.CustomerEmail</p>
                <p class="mb-1"><strong>Dirección:</strong> @Model.Order.ShippingAddress</p>
            </div>
            <div class="col-md-6">
                <h5>Pago y resumen</h5>
                <p class="mb-1"><strong>Método:</strong> @Model.Order.PaymentMethod</p>
                <p class="mb-1"><strong>Total:</strong> @Model.Order.Total.ToString("C")</p>
            </div>
        </div>

        <h5>Artículos</h5>
        <div class="table-responsive mb-4">
            <table class="table table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Producto</th>
                        <th class="text-end">Precio u.</th>
                        <th class="text-center">Cantidad</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Order.Items)
                    {
                        <tr>
                            <td>@(item.Product?.name ?? ("Producto " + item.ProductId))</td>
                            <td class="text-end">@item.UnitPrice.ToString("C")</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-end">@((item.UnitPrice * item.Quantity).ToString("C"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between">
            <a asp-page="/Orders/Confirmation" asp-route-id="@Model.Order.id" class="btn btn-secondary">Ver confirmación</a>
            @if(User.IsInRole("Admin"))
            {
                <a asp-page="/Orders/Edit" asp-route-id="@Model.Order.id" class="btn btn-warning"><i class="fa-solid fa-edit me-1"></i> Editar pedido</a>
                <a asp-page="/Adminitration/AdminDashboard" asp-route-id="@Model.Order.id" class="btn btn-primary">Volver</a>
            }
            else
            {
                <a asp-page="/Products/Index" class="btn btn-outline-primary"><i class="fa-solid fa-arrow-left me-1"></i> Seguir comprando</a>
            }
        </div>
    }
</div>