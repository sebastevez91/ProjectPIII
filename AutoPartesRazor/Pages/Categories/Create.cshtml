@page
@model AutoPartesRazor.Pages.Categories.CreateModel

@{
    ViewData["Title"] = "Crear categoría";
}
<div class="hero-section bg-primary bg-gradient text-white py-3 text-center">
    <div class="container py-4">
        <h1 class="display-4 fw-bold mb-3">Nueva Categoría</h1>
    </div>
</div>

<hr />
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card bg-dark text-white mb-3 shadow-sm border-0">
                <div class="card-body p-4">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="mb-4">
                            <label asp-for="Category.Name" class="control-label fs-4 fw-bold"></label>
                            <input asp-for="Category.Name" class="form-control" />
                            <span asp-validation-for="Category.Name" class="text-danger"></span>
                        </div>
                        <div class="d-grid gap-2 d-md-flex justify-content-md-between mt-4 pt-3 border-top">
                            <input type="submit" value="Crear" class="btn btn-primary" />
                            <a asp-page="/Administration/AdminDashboard" class="btn btn-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
