@page "{id:int}"
@model AutoPartesRazor.Pages.Orders.ConfirmationModel

@{
    ViewData["Title"] = "Pedido confirmado";
}

<div class="container py-4">
    <div class="alert alert-success">
        <h4 class="alert-heading">¡Pedido recibido!</h4>
        <p>Su pedido <strong>#@Model.OrderId</strong> se ha creado correctamente.</p>
    </div>

    <div>
        <a asp-page="/Products/Index" class="btn btn-primary">Seguir comprando</a>
        <a asp-page="/Orders/Details" asp-route-id="@Model.OrderId" class="btn btn-outline-secondary">Ver detalles del pedido</a>
    </div>
</div>